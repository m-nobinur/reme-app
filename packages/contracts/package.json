{
  "name": "@workspace/contracts",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "generate": "node scripts/generate.ts && openapi-typescript generated/openapi.json -o generated/openapi.d.ts && biome check --write --no-errors-on-unmatched generated",
    "check:drift": "pnpm generate && git diff --exit-code -- generated",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/floor.mjs contracts-unit -- vitest run"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-check": "^4.10.2",
    "openapi-typescript": "7.13.0",
    "typescript": "^6",
    "vitest": "^4.1.11"
  },
  "exports": {
    ".": "./src/index.ts",
    "./openapi.json": "./generated/openapi.json",
    "./openapi": "./generated/openapi.d.ts"
  }
}

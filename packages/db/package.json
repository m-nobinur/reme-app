{
  "name": "@workspace/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node scripts/migrate.ts",
    "probe:clear": "node scripts/clear-probes.ts",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/floor.mjs db-unit -- vitest run --dir test",
    "test:tenancy": "node ../../scripts/floor.mjs db-tenancy -- vitest run --dir tenancy",
    "test:seed": "node ../../scripts/floor.mjs db-seed -- vitest run --dir fixtures"
  },
  "dependencies": {
    "@workspace/config": "workspace:*",
    "@workspace/contracts": "workspace:*",
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.9",
    "ulid": "3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "drizzle-kit": "0.31.11",
    "typescript": "^6",
    "vitest": "^4.1.11"
  },
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./fixtures": "./fixtures/golden.ts",
    "./fixtures/seed": "./fixtures/seed.ts"
  }
}

---
// The quote form sends by email until the platform has an endpoint for it;
// see QuoteForm. The business's own phone and email sit under it for anyone
// who would rather call or write.
import ContactDetails from "../components/ContactDetails/ContactDetails.astro"
import Hero from "../components/Hero/Hero.astro"
import QuoteForm from "../components/QuoteForm/QuoteForm.astro"
import Base from "../layouts/Base.astro"
import { site } from "../site-config"
---

<Base title={site.quoteHeading} description={site.quoteIntro}>
  <Hero variant="compact" heading={site.quoteHeading} lede={site.quoteIntro} />
  <QuoteForm />
  <ContactDetails />
</Base>

---
import CtaBand from "../components/CtaBand/CtaBand.astro"
import Hero from "../components/Hero/Hero.astro"
import PriceCard from "../components/PriceCard/PriceCard.astro"
import Section from "../components/Section/Section.astro"
import ServiceCards from "../components/ServiceCards/ServiceCards.astro"
import Steps from "../components/Steps/Steps.astro"
import Base from "../layouts/Base.astro"
import { site } from "../site-config"
import { service } from "../structured-data"
---

<Base
  title={site.servicesHeading}
  description={site.servicesIntro}
  jsonLd={service(Astro.site)}
>
  <Hero
    variant="compact"
    heading={site.servicesHeading}
    lede={site.servicesIntro}
  />
  <ServiceCards />
  {
    site.standardCleanHourly && (
      <Section heading={site.priceHeading}>
        <PriceCard
          name={site.standardCleanName}
          price={site.standardCleanHourly}
        />
      </Section>
    )
  }
  <Steps />
  {
    site.serviceArea && (
      <Section heading={site.serviceAreaHeading}>
        <p>{site.serviceArea}</p>
      </Section>
    )
  }
  <CtaBand />
</Base>

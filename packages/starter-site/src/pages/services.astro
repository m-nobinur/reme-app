---
import CtaBand from "../components/CtaBand/CtaBand.astro"
import Hero from "../components/Hero/Hero.astro"
import Section from "../components/Section/Section.astro"
import ServiceCards from "../components/ServiceCards/ServiceCards.astro"
import Steps from "../components/Steps/Steps.astro"
import Base from "../layouts/Base.astro"
import { site } from "../site-config"
---

<Base title={site.servicesHeading} description={site.servicesIntro}>
  <Hero
    variant="compact"
    heading={site.servicesHeading}
    lede={site.servicesIntro}
  />
  <ServiceCards />
  {
    site.offerings && (
      <Section heading={site.offeringsHeading}>
        <ul class="offerings">
          {site.offerings
            .split("\n")
            .map((item) => item.trim())
            .filter(Boolean)
            .map((item) => (
              <li>{item}</li>
            ))}
        </ul>
      </Section>
    )
  }
  <Steps />
  {
    (site.serviceAreaText || site.serviceArea) && (
      <Section heading={site.serviceAreaHeading}>
        <p>{site.serviceAreaText || site.serviceArea}</p>
      </Section>
    )
  }
  <CtaBand />
</Base>

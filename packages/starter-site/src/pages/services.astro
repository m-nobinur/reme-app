---
import { faqsOf, pageDocument } from "../documents"
import Base from "../layouts/Base.astro"
import Sections from "../layouts/Sections.astro"
import { faqPage, services } from "../structured-data"

const doc = pageDocument("services")
---

<Base
  title={doc?.title ?? ""}
  description={doc?.description ?? ""}
  jsonLd={[...services(Astro.site), ...faqPage(faqsOf(doc))]}
>
  <Sections page="services" />
</Base>

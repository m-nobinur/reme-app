---
import Base from "../layouts/Base.astro"
import Sections from "../layouts/Sections.astro"
import { site } from "../site-config"
import { faqPage, services } from "../structured-data"
---

<Base
  title={site.servicesTitle || site.servicesHeading}
  description={site.servicesDescription || site.servicesIntro}
  jsonLd={[...services(Astro.site), ...faqPage()]}
>
  <Sections page="services" />
</Base>

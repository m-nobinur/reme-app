---
import ActionLink from "../components/ActionLink/ActionLink.astro"
import Hero from "../components/Hero/Hero.astro"
import Base from "../layouts/Base.astro"
import { site } from "../site-config"
---

<Base title={site.notFoundHeading} description="" noindex>
  <Hero heading={site.notFoundHeading} lede={site.notFoundBody}>
    <ActionLink href="/" label={site.homeLink} />
  </Hero>
</Base>

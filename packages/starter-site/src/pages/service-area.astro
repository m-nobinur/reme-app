---
import AreaSection from "../components/AreaSection/AreaSection.astro"
import CtaBand from "../components/CtaBand/CtaBand.astro"
import Hero from "../components/Hero/Hero.astro"
import Base from "../layouts/Base.astro"
import { site } from "../site-config"
import { localBusiness } from "../structured-data"
---

<Base
  title={site.serviceAreaTitle || site.serviceAreaHeading}
  description={site.serviceAreaDescription || site.serviceAreaIntro}
  jsonLd={localBusiness(Astro.site)}
>
  <Hero heading={site.serviceAreaHeading} lede={site.serviceAreaIntro} />
  <AreaSection />
  <CtaBand />
</Base>

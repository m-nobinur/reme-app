---
import ContactDetails from "../components/ContactDetails/ContactDetails.astro"
import CtaBand from "../components/CtaBand/CtaBand.astro"
import Hero from "../components/Hero/Hero.astro"
import Base from "../layouts/Base.astro"
import { site } from "../site-config"
import { localBusiness } from "../structured-data"
---

<Base
  title={site.contactTitle || site.contactHeading}
  description={site.contactDescription || site.contactIntro}
  jsonLd={localBusiness(Astro.site)}
>
  <Hero heading={site.contactHeading} lede={site.contactIntro} />
  <section class="band">
    <div class="wrap">
      <ContactDetails variant="cards" />
    </div>
  </section>
  <CtaBand />
</Base>

---
import Base from "../layouts/Base.astro"
import Sections from "../layouts/Sections.astro"
import { site } from "../site-config"
import { localBusiness } from "../structured-data"
---

<Base
  title={site.contactTitle || site.contactHeading}
  description={site.contactDescription || site.contactIntro}
  jsonLd={localBusiness(Astro.site)}
>
  <Sections page="contact" />
</Base>

---
import { pageDocument } from "../documents"
import { headerPhoto } from "../header-photo"
import Base from "../layouts/Base.astro"
import Sections from "../layouts/Sections.astro"
import { localBusiness } from "../structured-data"

const doc = pageDocument("contact")
---

<Base
  title={doc?.title ?? ""}
  description={doc?.description ?? ""}
  jsonLd={localBusiness(Astro.site)}
  image={headerPhoto("contact")}
>
  <Sections page="contact" />
</Base>

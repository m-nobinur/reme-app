---
import { plain } from "../accent"
import Base from "../layouts/Base.astro"
import Sections from "../layouts/Sections.astro"
import { sharePhoto } from "../header-photo"
import { site } from "../site-config"
import { localBusiness } from "../structured-data"
---

<Base
  title={site.contactTitle || plain(site.contactHeading)}
  description={site.contactDescription || site.contactIntro}
  image={sharePhoto("contact")}
  jsonLd={localBusiness(Astro.site)}
>
  <Sections page="contact" />
</Base>

---
import { plain } from "../../accent"
import Base from "../../layouts/Base.astro"
import Sections from "../../layouts/Sections.astro"
import {
  faqPage,
  type ServiceItem,
  servicePages,
  services,
} from "../../structured-data"

// One page per named service, at /services/<slug>/. Its sections and their
// order are layout.service in site-config, the same for every service; the
// words are that service's own fields.
export const getStaticPaths = () =>
  servicePages.map((item) => ({
    params: { slug: item.slug },
    props: { service: item },
  }))

interface Props {
  service: ServiceItem
}

const { service } = Astro.props
---

<Base
  title={service.title || plain(service.heading || service.name)}
  description={service.description || service.body}
  jsonLd={[...services(Astro.site, [service]), ...faqPage(service.faqs)]}
>
  <Sections page="service" service={service} />
</Base>

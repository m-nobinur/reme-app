---
import { faqsOf, pageDocument } from "../../documents"
import { headerPhoto } from "../../header-photo"
import Base from "../../layouts/Base.astro"
import Sections from "../../layouts/Sections.astro"
import {
  faqPage,
  type ServiceItem,
  servicePages,
  services,
} from "../../structured-data"

// One page per named service, at /services/<slug>/. Its sections and words
// are src/content/pages/services/<slug>.json.
export const getStaticPaths = () =>
  servicePages.map((item) => ({
    params: { slug: item.slug },
    props: { service: item },
  }))

interface Props {
  service: ServiceItem
}

const { service } = Astro.props
const doc = pageDocument("service", service.slug)
---

<Base
  title={doc?.title ?? ""}
  description={doc?.description ?? ""}
  jsonLd={[...services(Astro.site, [service]), ...faqPage(faqsOf(doc))]}
  image={headerPhoto(`service:${service.id}`)}
>
  <Sections page="service" service={service} />
</Base>

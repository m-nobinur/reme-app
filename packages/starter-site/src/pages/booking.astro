---
// No form yet. The booking endpoint does not exist, so this page offers the
// business's own contact routes and posts nothing. The orchestrator leaves it
// out of a tenant's seed until the endpoint lands, and navigation and the
// sitemap follow the page files, so it disappears from both.
import ContactDetails from "../components/ContactDetails/ContactDetails.astro"
import Hero from "../components/Hero/Hero.astro"
import Base from "../layouts/Base.astro"
import { site } from "../site-config"
---

<Base title={site.bookingHeading} description={site.bookingIntro}>
  <Hero heading={site.bookingHeading} lede={site.bookingIntro} />
  <section class="band">
    <div class="wrap">
      <ContactDetails variant="cards" />
    </div>
  </section>
</Base>

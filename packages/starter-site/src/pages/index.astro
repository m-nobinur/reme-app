---
import { faqsOf, pageDocument } from "../documents"
import Base from "../layouts/Base.astro"
import Sections from "../layouts/Sections.astro"
import { faqPage, localBusiness, webSite } from "../structured-data"

// The sections and their order are src/content/pages/home.json. A section
// with no facts behind it renders nothing, so a business with little to say
// gets a short page rather than a padded one.
const doc = pageDocument("home")
---

<Base
  title={doc?.title ?? ""}
  description={doc?.description ?? ""}
  jsonLd={[
    ...webSite(Astro.site),
    ...localBusiness(Astro.site),
    ...faqPage(faqsOf(doc)),
  ]}
>
  <Sections page="home" />
</Base>

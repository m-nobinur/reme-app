---
import Base from "../layouts/Base.astro"
import Sections from "../layouts/Sections.astro"
import { site } from "../site-config"
import { faqPage, localBusiness, webSite } from "../structured-data"

// The sections and their order are layout.home in site-config. A section with
// no facts behind it renders nothing, so a business with little to say gets a
// short page rather than a padded one.
---

<Base
  title={site.homeTitle || site.businessName}
  description={site.homeDescription || site.tagline || site.homeIntro}
  jsonLd={[
    ...webSite(Astro.site),
    ...localBusiness(Astro.site),
    ...faqPage(),
  ]}
>
  <Sections page="home" />
</Base>

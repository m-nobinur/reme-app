---
import ActionLink from "../components/ActionLink/ActionLink.astro"
import CtaBand from "../components/CtaBand/CtaBand.astro"
import Faq from "../components/Faq/Faq.astro"
import Gallery from "../components/Gallery/Gallery.astro"
import Hero from "../components/Hero/Hero.astro"
import Section from "../components/Section/Section.astro"
import ServiceCards from "../components/ServiceCards/ServiceCards.astro"
import Stats from "../components/Stats/Stats.astro"
import Steps from "../components/Steps/Steps.astro"
import Testimonials from "../components/Testimonials/Testimonials.astro"
import ValueProps from "../components/ValueProps/ValueProps.astro"
import Base from "../layouts/Base.astro"
import { templateOf } from "../presets"
import { primaryAction } from "../routes"
import { site } from "../site-config"
import { localBusiness, webSite } from "../structured-data"

// One page, three layouts. Classic leads with trust: a split hero, then the
// figures. Modern leads with pictures: a centred hero, then the gallery.
// Bold leads with the figures on a band under a compact hero. The rest of
// the order is shared, and styles/site.css does the rest by data-template.
const template = templateOf(site.template)
const HERO = { classic: "split", modern: "centered", bold: "compact" } as const
---

<Base
  title={site.businessName}
  description={site.tagline}
  jsonLd={[...webSite(Astro.site), ...localBusiness(Astro.site)]}
>
  <Hero
    variant={HERO[template]}
    eyebrow={site.industry}
    heading={site.heroHeading || site.businessName}
    lede={site.tagline}
  >
    {
      primaryAction && (
        <ActionLink href={primaryAction.href} label={primaryAction.label} />
      )
    }
    {
      site.phone && (
        <ActionLink
          href={`tel:${site.phone}`}
          label={site.phone}
          variant="secondary"
        />
      )
    }
  </Hero>
  {template === "modern" ? <Gallery /> : <Stats />}
  {site.homeIntro && <p class="intro">{site.homeIntro}</p>}
  <ServiceCards />
  <ValueProps />
  {
    (site.overview || site.audience) && (
      <Section heading={site.aboutHeading}>
        {site.overview && <p>{site.overview}</p>}
        {site.audience && site.audienceHeading && (
          <h3>{site.audienceHeading}</h3>
        )}
        {site.audience && <p>{site.audience}</p>}
      </Section>
    )
  }
  <Steps />
  <Testimonials />
  {template === "modern" ? <Stats /> : <Gallery />}
  <Faq />
  <CtaBand />
</Base>

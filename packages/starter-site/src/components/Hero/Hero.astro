---
import Icon from "../Icon/Icon.astro"

interface Props {
  /** The page's h1, from a site field. */
  heading: string
  /** A sentence or two under it. */
  lede?: string
  /** A short line above it, as site.industry. */
  eyebrow?: string
  /** home on the home page, page elsewhere. */
  variant?: "home" | "page"
  /** The home photo, shown with both halves. */
  image?: { src: string; alt: string }
  /** Services shown when there is no photo. */
  highlights?: { name: string; icon: string }[]
}

const {
  heading,
  lede = "",
  eyebrow = "",
  variant = "page",
  image,
  highlights = [],
} = Astro.props
const photo = variant === "home" && image?.src && image.alt ? image : null
const listed =
  variant === "home" && !photo ? highlights.filter((h) => h.name) : []
// Rendered rather than slotted, so a hero whose actions all resolve to
// nothing is a hero with no actions and not an empty row.
const actions = Astro.slots.has("default")
  ? (await Astro.slots.render("default")).trim()
  : ""
---

{
  (heading || lede || actions) && (
    <section
      class:list={[
        "hero",
        `hero-${variant}`,
        variant === "home" && (photo ? "hero-photo" : "hero-plain"),
      ]}
    >
      <div class="wrap hero-inner">
        <div class="hero-text">
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          {heading && <h1>{heading}</h1>}
          {lede && <p class="lede">{lede}</p>}
          {actions && <div class="actions" set:html={actions} />}
        </div>
        {photo && (
          <img
            class="hero-image"
            src={photo.src}
            alt={photo.alt}
            fetchpriority="high"
            decoding="async"
          />
        )}
        {listed.length > 0 && (
          <ul class="hero-list">
            {listed.map((item) => (
              <li>
                <Icon name={item.icon} />
                <span>{item.name}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}

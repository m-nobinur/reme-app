---
interface Props {
  heading: string
  lede?: string
}

const { heading, lede = "" } = Astro.props
const hasActions = Astro.slots.has("default")
---

<section class="hero">
  {heading && <h1>{heading}</h1>}
  {lede && <p class="lede">{lede}</p>}
  {
    hasActions && (
      <div class="actions">
        <slot />
      </div>
    )
  }
</section>

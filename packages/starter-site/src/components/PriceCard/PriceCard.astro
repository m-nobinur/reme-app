---
interface Props {
  /** The service's name, read from a site field. */
  name: string
  /** A pricing fact's field as the site config renders it. */
  price: string
}

const { name, price } = Astro.props
---

{
  name && price && (
    <div class="price-card">
      <p class="price-name">{name}</p>
      <p class="price-value">{price}</p>
    </div>
  )
}

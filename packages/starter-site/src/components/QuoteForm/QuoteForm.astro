---
import { type QuoteField, quoteFields } from "../../quote-form"
import { site } from "../../site-config"

// A request goes to site.quoteFormAction once the platform has an endpoint
// for it; that is where the endpoint plugs in. Until then it goes by email:
// a mailto action with text/plain opens the visitor's mail app with each
// field on its own line. With neither there is nowhere to send it, so the
// form is left out rather than posting to itself.
const byEmail = !site.quoteFormAction
const action =
  site.quoteFormAction ||
  (site.email
    ? `mailto:${site.email}?subject=${encodeURIComponent(site.quoteEmailSubject)}`
    : "")

/** Longest answer per input type; date and number take no maxlength. */
const MAX: Record<string, number> = { text: 200, email: 254, tel: 40 }
/** The browser's autofill token, where the type alone says what it is. */
const AUTOCOMPLETE: Record<string, string> = { email: "email", tel: "tel" }

type Control = {
  id: string
  name: string
  type: QuoteField["type"]
  label: string
  required: boolean
  hint: string
  options: string[]
  autocomplete: string | undefined
}

// The contact details every request needs, in the site's words.
const person = (
  name: string,
  type: QuoteField["type"],
  label: string,
  required: boolean
) => ({
  id: `quote-${name}`,
  name,
  type,
  label,
  required,
  hint: "",
  options: [],
  autocomplete: AUTOCOMPLETE[type] ?? name,
})
const contact: Control[] = [
  person("name", "text", site.quoteNameLabel, true),
  person("email", "email", site.quoteEmailLabel, true),
  person("phone", "tel", site.quotePhoneLabel, false),
].filter((field) => field.label)

// The owner's questions from src/quote-form.json, exactly as approved. Their
// ids carry a prefix of their own, so a question keyed `email` never shares
// an id with the contact field above.
const questions: Control[] = quoteFields.map((field) => ({
  id: `quote-q-${field.key}`,
  name: field.key,
  type: field.type,
  label: field.label,
  required: field.required,
  hint: field.hint ?? "",
  options: field.options ?? [],
  autocomplete: AUTOCOMPLETE[field.type],
}))

const groups = [
  { legend: site.quoteContactLegend, fields: contact },
  { legend: site.quoteRequestLegend, fields: questions },
].filter((group) => group.fields.length > 0)

// Files need an endpoint: a mail link carries none, so by email a photo
// question takes links alone.
const files = !byEmail && questions.some((field) => field.type === "photos")
const enctype = byEmail
  ? "text/plain"
  : files
    ? "multipart/form-data"
    : undefined
/** The browser's input type, where it differs from the question's. */
const INPUT: Record<string, string> = { datetime: "datetime-local" }
---

{
  action && (
    <form
      class="quote-form"
      action={action}
      method="post"
      enctype={enctype}
    >
      {groups.map((group) => (
        <fieldset>
          {group.legend && <legend>{group.legend}</legend>}
          {group.fields.map((field) => {
            const hint = field.hint ? `${field.id}-hint` : undefined
            const common = {
              id: field.id,
              name: field.name,
              required: field.required,
              autocomplete: field.autocomplete,
              "aria-describedby": hint,
            }
            const optional = !field.required && site.quoteOptional && (
              <span class="quote-optional">{site.quoteOptional}</span>
            )
            const hintLine = field.hint && (
              <p class="quote-hint" id={hint}>
                {field.hint}
              </p>
            )
            if (field.type === "radio" || field.type === "checkbox") {
              // shortcut: a checkbox group cannot be required without
              // script, so only a radio group is; check it on the endpoint.
              return (
                <fieldset class="quote-field" aria-describedby={hint}>
                  <legend>
                    {field.label}
                    {optional}
                  </legend>
                  {hintLine}
                  <div class="quote-options">
                    {field.options.map((option, i) => (
                      <label class="quote-option" for={`${field.id}-${i}`}>
                        <input
                          id={`${field.id}-${i}`}
                          name={field.name}
                          type={field.type}
                          value={option}
                          required={field.type === "radio" && field.required}
                        />
                        <span>{option}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
              )
            }
            return (
              <div class="quote-field">
                <label for={field.id}>
                  {field.label}
                  {optional}
                </label>
                {hintLine}
                {field.type === "photos" && files ? (
                  <>
                    <div class="quote-drop">
                      {/* Links answer it as well, so the files are never required. */}
                      <input
                        {...{ ...common, required: false }}
                        type="file"
                        accept="image/*"
                        multiple
                      />
                      <span class="quote-drop-label" aria-hidden="true">
                        {site.quotePhotoDrop}
                      </span>
                    </div>
                    <label class="quote-sublabel" for={`${field.id}-links`}>
                      {site.quotePhotoLinks}
                    </label>
                    <textarea
                      id={`${field.id}-links`}
                      name={`${field.name}_links`}
                      rows="2"
                      maxlength="2000"
                    />
                  </>
                ) : field.type === "photos" ? (
                  <>
                    <p class="quote-hint" id={`${field.id}-links`}>
                      {site.quotePhotoLinks}
                    </p>
                    <textarea
                      {...{
                        ...common,
                        "aria-describedby": [hint, `${field.id}-links`]
                          .filter(Boolean)
                          .join(" "),
                      }}
                      rows="3"
                      maxlength="2000"
                    />
                  </>
                ) : field.type === "textarea" ? (
                  <textarea {...common} rows="5" maxlength="2000" />
                ) : field.type === "select" ? (
                  <select {...common}>
                    <option value="">{site.quoteChoose}</option>
                    {field.options.map((option) => (
                      <option>{option}</option>
                    ))}
                  </select>
                ) : (
                  <input
                    {...common}
                    type={INPUT[field.type] ?? field.type}
                    maxlength={MAX[field.type]}
                    min={field.type === "number" ? "0" : undefined}
                  />
                )}
              </div>
            )
          })}
        </fieldset>
      ))}
      <div class="quote-submit">
        <button class="action action-primary" type="submit">
          {site.quoteSubmit}
        </button>
        {site.quoteNextSteps && <p>{site.quoteNextSteps}</p>}
        {site.quotePrivacy && <p>{site.quotePrivacy}</p>}
      </div>
    </form>
  )
}

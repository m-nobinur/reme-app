---
import SectionHead from "../../layouts/SectionHead.astro"
import { site } from "../../site-config"

interface Props {
  /** circles on a tint band, dark_band beside its heading, timeline on a line. */
  variant?: "circles" | "dark_band" | "timeline"
  /** The h2, where a page has its own; empty is site.stepsHeading. */
  heading?: string
  /** The steps, where a page has its own; empty is the site's step1 to step4. */
  items?: { title: string; body: string }[]
}

const {
  variant = "timeline",
  heading = site.stepsHeading,
  items = ([1, 2, 3, 4] as const)
    .map((n) => ({ title: site[`step${n}Title`], body: site[`step${n}Body`] }))
    .filter((item) => item.title || item.body),
} = Astro.props
---

{
  items.length > 0 && (
    <section
      class:list={[
        "band steps",
        `steps-${variant}`,
        variant !== "timeline" && "band-tint",
      ]}
    >
      <div class="wrap steps-inner">
        <SectionHead eyebrow={site.stepsEyebrow} heading={heading} />
        <ol class="step-list">
          {items.map((item) => (
            <li>
              {item.title && <h3>{item.title}</h3>}
              {item.body && <p data-copy="step_body">{item.body}</p>}
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

---
import { plain } from "../../accent"
import SectionHead from "../../layouts/SectionHead.astro"
import { pageFields } from "../../page-fields"

interface Props {
  /** circles on a tint band, dark_band beside its heading, timeline on a line. */
  variant?: "circles" | "dark_band" | "timeline"
  /** The h2, where a page has its own; empty is the stepsHeading slot's default. */
  heading?: string
  /** The steps, where a page has its own; empty is the site's step1 to step4. */
  items?: { title: string; body: string }[]
  /** The short label above the h2; empty is the stepsEyebrow slot's default. */
  eyebrow?: string
}

const {
  variant = "timeline",
  heading = pageFields.stepsHeading,
  eyebrow = pageFields.stepsEyebrow,
  items = ([1, 2, 3, 4] as const)
    .map((n) => ({
      title: pageFields[`step${n}Title`],
      body: pageFields[`step${n}Body`],
    }))
    .filter((item) => item.title || item.body),
} = Astro.props
---

{
  items.length > 0 && (
    <section
      class:list={[
        "band steps",
        `steps-${variant}`,
        variant !== "timeline" && "band-tint",
      ]}
    >
      <div class="wrap steps-inner">
        <SectionHead eyebrow={eyebrow} heading={heading} />
        <ol class="step-list">
          {items.map((item) => (
            <li>
              {item.title && <h3>{plain(item.title)}</h3>}
              {item.body && <p data-copy="step_body">{item.body}</p>}
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

---
import { iconFor } from "../../icons"
import { hasRoute } from "../../routes"
import { site } from "../../site-config"
import { servicePages } from "../../structured-data"
import Icon from "../Icon/Icon.astro"

interface Props {
  /** icons in columns split by hairlines, phrases in one tracked line. */
  variant?: "icons" | "phrases"
}

const { variant = "icons" } = Astro.props
// Figures are fact fields; a figure with no value does not render, label or
// no label. The points restate business.proof and are empty without it. So
// with no proof and no figures there is no strip at all.
const figures = [
  {
    value: site.statYearsValue,
    label: site.statYearsLabel,
    icon: "calendarCheck",
  },
  { value: site.statClientsValue, label: site.statClientsLabel, icon: "users" },
  { value: site.statRatingValue, label: site.statRatingLabel, icon: "star" },
].filter((item) => item.value)
// Each point shows the icon its words call for, no two alike where another fits.
const taken = new Set<string>(figures.map((item) => item.icon))
const points: { text: string; icon: string }[] = [
  site.trust1,
  site.trust2,
  site.trust3,
]
  .filter(Boolean)
  .map((text) => {
    const icon = iconFor("", text, "checkCircle", taken)
    taken.add(icon)
    return { text, icon }
  })
const towns = site.areaTowns.split("\n").filter((line) => line.trim())
if (figures.length + points.length === 0) {
  const plain = [
    {
      text:
        site.serviceArea ||
        (towns.length > 1 ? `Covering ${towns.length} local areas` : ""),
      icon: "mapPin",
    },
    {
      text: site.weekdayHours ? `Open weekdays ${site.weekdayHours}` : "",
      icon: "clock",
    },
    {
      text: hasRoute("/quote/") ? "Request a quote online" : "",
      icon: "clipboardText",
    },
    {
      text:
        servicePages.length > 1
          ? `${servicePages.length} services to choose from`
          : "",
      icon: "listChecks",
    },
  ].filter((item) => item.text)
  if (plain.length >= 2) points.push(...plain)
}
const count = figures.length + points.length
// Columns on a wide screen: one row up to four items, rows of three past that.
const columns = count <= 4 ? count : 3
---

{
  count > 0 && (
    <section class:list={["trust-strip", `trust-${variant}`]}>
      <div class="wrap">
        <ul class="trust-list" style={`--trust-cols: ${columns}`}>
          {figures.map((item) => (
            <li>
              {variant === "icons" && (
                <span class="trust-icon">
                  <Icon name={item.icon} />
                </span>
              )}
              <span class="trust-text">
                <span class="trust-value">{item.value}</span>
                {item.label && <span class="trust-label">{item.label}</span>}
              </span>
            </li>
          ))}
          {points.map((point) => (
            <li>
              {variant === "icons" && (
                <span class="trust-icon">
                  <Icon name={point.icon} />
                </span>
              )}
              <span class="trust-text">{point.text}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

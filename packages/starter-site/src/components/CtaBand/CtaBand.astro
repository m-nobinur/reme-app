---
import Photo from "../../layouts/Photo.astro"
import SectionHead from "../../layouts/SectionHead.astro"
import { phoneText } from "../../phone"
import { primaryAction } from "../../routes"
import { site } from "../../site-config"
import ActionLink from "../ActionLink/ActionLink.astro"

interface Props {
  /** solid is the brand colour, photo puts site.ctaImage under it. */
  variant?: "solid" | "photo"
}

const { variant = "solid" } = Astro.props
const image = variant === "photo" ? site.ctaImage : ""
---

{
  (site.ctaHeading || site.ctaBody) && (
    <section
      class:list={["band band-tint cta-band", image && "cta-photo"]}
      data-repeats
    >
      {image && (
        <Photo class="cta-image" src={image} alt="" sizes="100vw" />
      )}
      <div class="wrap cta-inner">
        <div class="cta-text">
          <SectionHead bare eyebrow={site.ctaEyebrow} heading={site.ctaHeading} />
          {site.ctaBody && <p class="cta-body">{site.ctaBody}</p>}
        </div>
        <div class="actions">
          {primaryAction && (
            <ActionLink
              href={primaryAction.href}
              label={site.ctaLabel || primaryAction.label}
            />
          )}
          {site.phone && (
            <ActionLink
              href={`tel:${site.phone}`}
              label={phoneText(site.phone)}
              variant="secondary"
            />
          )}
        </div>
      </div>
    </section>
  )
}

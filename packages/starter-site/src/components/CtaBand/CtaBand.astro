---
import { primaryAction } from "../../routes"
import { site } from "../../site-config"
import ActionLink from "../ActionLink/ActionLink.astro"
---

{
  (site.ctaHeading || site.ctaBody) && (
    <section class="cta-band">
      <div class="wrap cta-inner">
        <div class="cta-text">
          {site.ctaHeading && <h2>{site.ctaHeading}</h2>}
          {site.ctaBody && <p>{site.ctaBody}</p>}
        </div>
        <div class="actions">
          {primaryAction && (
            <ActionLink
              href={primaryAction.href}
              label={site.ctaLabel || primaryAction.label}
            />
          )}
          {site.phone && (
            <ActionLink
              href={`tel:${site.phone}`}
              label={site.phone}
              variant="secondary"
            />
          )}
        </div>
      </div>
    </section>
  )
}

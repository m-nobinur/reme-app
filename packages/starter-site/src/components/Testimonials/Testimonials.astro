---
import SectionHead from "../../layouts/SectionHead.astro"
import { pageFields } from "../../page-fields"
import { site } from "../../site-config"

interface Props {
  /** featured sets the first review larger on a tint, wall sets them evenly. */
  variant?: "featured" | "wall"
  /** The short label above the h2; empty is the testimonialsEyebrow slot's default. */
  eyebrow?: string
  /** The h2; empty is the testimonialsHeading slot's default. */
  heading?: string
}

const {
  variant = "wall",
  eyebrow = pageFields.testimonialsEyebrow,
  heading = pageFields.testimonialsHeading,
} = Astro.props
// Quote and author are both facts. Nothing here is written: a review the
// facts do not carry is a review the site does not show.
const items = [
  { quote: site.testimonial1Quote, author: site.testimonial1Author },
  { quote: site.testimonial2Quote, author: site.testimonial2Author },
].filter((item) => item.quote)
---

{
  items.length > 0 && (
    <section class:list={["band testimonials", `testimonials-${variant}`]}>
      <div class="wrap">
        <SectionHead eyebrow={eyebrow} heading={heading} />
        <div class="quote-grid">
          {items.map((item) => (
            <figure class="card">
              <blockquote>{item.quote}</blockquote>
              {item.author && <figcaption>{item.author}</figcaption>}
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}

---
import Photo from "../../layouts/Photo.astro"
import SectionHead from "../../layouts/SectionHead.astro"
import { hasRoute, primaryAction } from "../../routes"
import { site } from "../../site-config"
import { serviceItems } from "../../structured-data"
import ActionLink from "../ActionLink/ActionLink.astro"
import Icon from "../Icon/Icon.astro"

interface Props {
  /** The pattern. alternating is the services page's own. photo_cards shows numbered_rows unless every service has a photo, and alternating off the services page unless one has. */
  variant?:
    | "photo_cards"
    | "numbered_rows"
    | "alternating"
    | "fleet"
    | "practice_list"
}

const { variant: asked = "photo_cards" } = Astro.props
const items = serviceItems.map((item) => ({
  ...item,
  photo: item.image.src && item.image.alt ? item.image : null,
}))
const onServices = Astro.url.pathname === "/services/"
// A pattern built on pictures, with none to show, is one icon card three times
// over: numbered rows carry the same services as a list. Cards need a photo
// each; the services page keeps its detail rows either way, as the one place
// the full lists live.
const variant =
  (asked === "photo_cards" && !items.every((item) => item.photo)) ||
  (asked === "alternating" && !onServices && !items.some((item) => item.photo))
    ? "numbered_rows"
    : asked
// Alternating rows are the services page itself, the place every other
// pattern links to, so they link nowhere and the page's hero is their head.
const detail = variant === "alternating"
const linked = !detail && hasRoute("/services/")
const href = (id: string) => `/services/#${id}`
// Cards per row on a wide screen: four in one row, otherwise rows of three,
// a short last row centred (site.css counts the cards itself).
const perRow = items.length === 4 ? 4 : 3
const number = (i: number) => String(i + 1).padStart(2, "0")
// A linked card's name is the link, stretched over the card; the words and
// arrow at its foot repeat it for the eye, so they are hidden from readers.
---

{
  items.length > 0 && (
    <section
      class:list={[
        "band service-cards",
        `services-${variant}`,
        detail && "service-details",
      ]}
    >
      <div class="wrap">
        {!(detail && onServices) && (
          <SectionHead
            eyebrow={site.serviceCardsEyebrow}
            heading={site.serviceCardsHeading}
          />
        )}
        {(variant === "photo_cards" || variant === "fleet") && (
          <ul class="card-grid">
            {items.map((item, i) => (
              <li class:list={["card", linked && "card-linked"]}>
                {item.photo ? (
                  <div class="card-media">
                    <Photo
                      class="card-photo"
                      src={item.photo.src}
                      alt={item.photo.alt}
                      sizes={`(min-width: 80rem) ${perRow === 4 ? 19 : 26}rem, (min-width: 64rem) ${Math.floor(100 / perRow)}vw, (min-width: 40rem) 50vw, calc(100vw - 2rem)`}
                    />
                    {variant === "photo_cards" && (
                      <span class="card-tag">
                        <Icon name={item.icon} />
                        <span>{number(i)}</span>
                      </span>
                    )}
                  </div>
                ) : (
                  variant === "photo_cards" && (
                    <span class="card-icon">
                      <Icon name={item.icon} />
                    </span>
                  )
                )}
                {item.name && (
                  <h3>
                    {linked ? <a href={href(item.id)}>{item.name}</a> : item.name}
                  </h3>
                )}
                {item.body && <p>{item.body}</p>}
                {variant === "fleet" && item.includes.length > 0 && (
                  <ul class="spec-pills">
                    {item.includes.map((line) => (
                      <li>{line}</li>
                    ))}
                  </ul>
                )}
                {linked && (
                  <span class="card-arrow" aria-hidden="true">
                    {site.serviceMoreLabel}
                  </span>
                )}
              </li>
            ))}
          </ul>
        )}
        {(variant === "numbered_rows" || variant === "practice_list") && (
          <ol class:list={["service-rows", linked && "rows-linked"]}>
            {items.map((item) => (
              <li>
                {variant === "numbered_rows" && (
                  <span class="card-icon">
                    <Icon name={item.icon} />
                  </span>
                )}
                <div class="row-text">
                  {item.name && (
                    <h3>
                      {linked ? (
                        <a href={href(item.id)}>{item.name}</a>
                      ) : (
                        item.name
                      )}
                    </h3>
                  )}
                  {item.body && <p>{item.body}</p>}
                </div>
                {linked && <span class="row-arrow" aria-hidden="true" />}
              </li>
            ))}
          </ol>
        )}
        {detail &&
          items.map((item) => (
            <article class="service-detail" id={item.id}>
              {item.photo && (
                <Photo
                  class="service-photo"
                  src={item.photo.src}
                  alt={item.photo.alt}
                  sizes="(min-width: 80rem) 36rem, (min-width: 56rem) 50vw, 100vw"
                />
              )}
              <div class="service-detail-main">
                <Icon name={item.icon} />
                {site.serviceCardsEyebrow && (
                  <p class="eyebrow">{site.serviceCardsEyebrow}</p>
                )}
                {item.name && <h2>{item.name}</h2>}
                {item.body && <p class="service-detail-body">{item.body}</p>}
                {primaryAction && (
                  <ActionLink
                    href={primaryAction.href}
                    label={primaryAction.label}
                    variant="secondary"
                  />
                )}
              </div>
              {(item.includes.length > 0 || item.for) && (
                <div class="service-detail-facts">
                  {item.includes.length > 0 && (
                    <>
                      {site.serviceIncludesLabel && (
                        <h3 class="facts-label">{site.serviceIncludesLabel}</h3>
                      )}
                      <ul class="check-list">
                        {item.includes.map((line) => (
                          <li>
                            <Icon name="checkCircle" />
                            <span>{line}</span>
                          </li>
                        ))}
                      </ul>
                    </>
                  )}
                  {item.for && (
                    <>
                      {site.serviceForLabel && (
                        <h3 class="facts-label">{site.serviceForLabel}</h3>
                      )}
                      <p>{item.for}</p>
                    </>
                  )}
                </div>
              )}
            </article>
          ))}
        {linked && site.serviceCardsLink && (
          <p class="section-more">
            <a class="more-link" href="/services/">
              {site.serviceCardsLink}
            </a>
          </p>
        )}
      </div>
    </section>
  )
}

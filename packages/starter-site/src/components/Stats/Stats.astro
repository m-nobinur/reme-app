---
import { site } from "../../site-config"

// The value is the fact; the label only names it. A stat with no value is a
// stat nobody can check, so it does not render.
const items = [
  { value: site.statYearsValue, label: site.statYearsLabel },
  { value: site.statClientsValue, label: site.statClientsLabel },
  { value: site.statRatingValue, label: site.statRatingLabel },
].filter((item) => item.value)
---

{
  items.length > 0 && (
    <dl class="stats">
      {items.map((item) => (
        <div>
          {item.label && <dt>{item.label}</dt>}
          <dd>{item.value}</dd>
        </div>
      ))}
    </dl>
  )
}

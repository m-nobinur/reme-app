---
import SectionHead from "../../layouts/SectionHead.astro"

interface Props {
  /** The section's h2, read from a site field. */
  heading: string
  /** The short label above the h2, read from a site field. */
  eyebrow: string
}

const { heading, eyebrow } = Astro.props
---

<section class="band section">
  <div class="wrap section-inner">
    <SectionHead eyebrow={eyebrow} heading={heading} />
    <div class="section-body">
      <slot />
    </div>
  </div>
</section>

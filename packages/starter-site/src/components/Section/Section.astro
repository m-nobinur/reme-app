---
interface Props {
  /** The section's h2, read from a site field. */
  heading: string
}

const { heading } = Astro.props
---

<section class="band section">
  <div class="wrap section-inner">
    {heading && <h2>{heading}</h2>}
    <div class="section-body">
      <slot />
    </div>
  </div>
</section>

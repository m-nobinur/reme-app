---
import { phoneText } from "../../phone"
import { site } from "../../site-config"
import Icon from "../Icon/Icon.astro"

interface Props {
  /** cards on the contact page, list elsewhere. */
  variant?: "list" | "cards"
}

const { variant = "list" } = Astro.props

const rows = [
  {
    icon: "phone",
    label: site.phoneLabel,
    value: site.phone && phoneText(site.phone),
    href: site.phone ? `tel:${site.phone}` : "",
  },
  {
    icon: "envelope",
    label: site.emailLabel,
    value: site.email,
    href: site.email ? `mailto:${site.email}` : "",
  },
  {
    icon: "clock",
    label: site.weekdayHoursLabel,
    value: site.weekdayHours,
    href: "",
  },
  {
    icon: "mapPin",
    // The nav's short label: the page heading may be a whole sentence.
    label: site.navServiceArea || site.serviceAreaHeading,
    value: site.serviceAreaText || site.serviceArea,
    href: "",
  },
].filter((row) => row.value)
---

{
  rows.length > 0 && (
    <dl class:list={["contact-details", `contact-${variant}`]}>
      {rows.map((row) => (
        <div>
          <dt>
            <span class="card-icon">
              <Icon name={row.icon} />
            </span>
            {row.label}
          </dt>
          <dd>{row.href ? <a href={row.href}>{row.value}</a> : row.value}</dd>
        </div>
      ))}
    </dl>
  )
}

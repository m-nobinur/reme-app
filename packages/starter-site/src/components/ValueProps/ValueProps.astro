---
import { iconPath } from "../../icons"
import SectionHead from "../../layouts/SectionHead.astro"
import { site } from "../../site-config"
import Icon from "../Icon/Icon.astro"

const items = ([1, 2, 3] as const)
  .map((n) => ({
    title: site[`valueProp${n}Title`],
    body: site[`valueProp${n}Body`],
    icon: site[`valueProp${n}Icon`],
  }))
  .filter((item) => item.title || item.body)
---

{
  items.length > 0 && (
    <section class="band band-tint value-props">
      <div class="wrap value-inner">
        <SectionHead
          eyebrow={site.valuePropsEyebrow}
          heading={site.valuePropsHeading}
        />
        <ul class="value-list">
          {items.map((item) => (
            <li>
              <span class="card-icon">
                <Icon name={iconPath(item.icon) ? item.icon : "checkCircle"} />
              </span>
              <div>
                {item.title && <h3>{item.title}</h3>}
                {item.body && <p>{item.body}</p>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

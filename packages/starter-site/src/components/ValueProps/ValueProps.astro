---
import { site } from "../../site-config"

const items = [
  { title: site.valueProp1Title, body: site.valueProp1Body },
  { title: site.valueProp2Title, body: site.valueProp2Body },
  { title: site.valueProp3Title, body: site.valueProp3Body },
].filter((item) => item.title || item.body)
---

{
  items.length > 0 && (
    <section class="value-props">
      {site.valuePropsHeading && <h2>{site.valuePropsHeading}</h2>}
      <ul class="card-grid">
        {items.map((item) => (
          <li class="card">
            <svg class="mark" viewBox="0 0 256 256" aria-hidden="true">
              <path
                fill="currentColor"
                d="M173.66,98.34a8,8,0,0,1,0,11.32l-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35A8,8,0,0,1,173.66,98.34ZM232,128A104,104,0,1,1,128,24,104.11,104.11,0,0,1,232,128Zm-16,0a88,88,0,1,0-88,88A88.1,88.1,0,0,0,216,128Z"
              />
            </svg>
            {item.title && <h3>{item.title}</h3>}
            {item.body && <p>{item.body}</p>}
          </li>
        ))}
      </ul>
    </section>
  )
}

---
import { plain } from "../../accent"
import { iconFor } from "../../icons"
import SectionHead from "../../layouts/SectionHead.astro"
import { pageFields } from "../../page-fields"
import Icon from "../Icon/Icon.astro"

interface Props {
  /** default: reasons beside the heading, each in an icon circle and no number; hairline_rows: full-width rows under the heading, between hairlines, a small icon leading each. */
  variant?: "default" | "hairline_rows"
  /** The short label above the h2, where a page has its own; empty is the valuePropsEyebrow slot's default. */
  eyebrow?: string
  /** The h2, where a page has its own; empty is the valuePropsHeading slot's default. */
  heading?: string
  /** The entries, where a page has its own; empty is the site's valueProp1 to valueProp3. */
  items?: { title: string; body: string; icon: string }[]
  /** The copy gate's data-copy mark on each body, where the page's brief gives it a word range. */
  copy?: string
}

const {
  variant = "default",
  eyebrow = pageFields.valuePropsEyebrow,
  heading = pageFields.valuePropsHeading,
  items = ([1, 2, 3] as const).map((n) => ({
    title: pageFields[`valueProp${n}Title`],
    body: pageFields[`valueProp${n}Body`],
    icon: pageFields[`valueProp${n}Icon`],
  })),
  copy,
} = Astro.props
const shown = items.filter((item) => item.title || item.body)
const rows = variant === "hairline_rows"
---

{
  shown.length > 0 && (
    <section class:list={["band value-props", `value-props-${variant}`]}>
      <div class:list={["wrap", !rows && "value-inner"]}>
        <div class="value-head">
          <SectionHead
            eyebrow={eyebrow}
            heading={heading}
          />
        </div>
        <ul class={rows ? "value-rows" : "value-list"}>
          {shown.map((item) => (
            <li>
              <span class={rows ? undefined : "card-icon"}>
                <Icon name={iconFor(item.icon, `${item.title} ${item.body}`)} />
              </span>
              <div>
                {item.title && <h3>{plain(item.title)}</h3>}
                {item.body && <p data-copy={copy}>{item.body}</p>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

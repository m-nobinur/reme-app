---
import SectionHead from "../../layouts/SectionHead.astro"
import { pageFields } from "../../page-fields"
import { hasRoute } from "../../routes"
import { site } from "../../site-config"
import { faqItems } from "../../structured-data"

interface Props {
  /** split puts the heading beside the questions, stacked above them. */
  variant?: "split" | "stacked"
  /** The questions, where a page has its own; empty is the site's FAQ. */
  items?: { question: string; answer: string }[]
  /** The h2, where a page has its own; empty is the faqHeading slot's default. */
  heading?: string
  /** The short label above the h2; empty is the faqEyebrow slot's default. */
  eyebrow?: string
  /** One or two sentences under the h2; empty is the faqIntro slot's default. */
  intro?: string
}

const {
  variant = "split",
  items = faqItems,
  heading = pageFields.faqHeading,
  eyebrow = pageFields.faqEyebrow,
  intro = pageFields.faqIntro,
} = Astro.props
// Off the contact page, a question the list does not answer goes there.
const more =
  site.faqLink && hasRoute("/contact/") && Astro.url.pathname !== "/contact/"
---

{
  items.length > 0 && (
    <section class:list={["band faq", `faq-${variant}`]}>
      <div class="wrap faq-inner">
        <div class="faq-intro">
          <SectionHead eyebrow={eyebrow} heading={heading} />
          {intro && <p class="faq-lede">{intro}</p>}
          {more && (
            <p class="section-more">
              <a class="more-link" href="/contact/">
                {site.faqLink}
              </a>
            </p>
          )}
        </div>
        <div class="faq-list">
          {items.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p data-copy="faq_answer">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

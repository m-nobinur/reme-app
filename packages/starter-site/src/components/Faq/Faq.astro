---
import SectionHead from "../../layouts/SectionHead.astro"
import { site } from "../../site-config"
import { faqItems as items } from "../../structured-data"

interface Props {
  /** split puts the heading beside the questions, stacked above them. */
  variant?: "split" | "stacked"
}

const { variant = "split" } = Astro.props
---

{
  items.length > 0 && (
    <section class:list={["band faq", `faq-${variant}`]}>
      <div class="wrap faq-inner">
        <SectionHead eyebrow={site.faqEyebrow} heading={site.faqHeading} />
        <div class="faq-list">
          {items.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

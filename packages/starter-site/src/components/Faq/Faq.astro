---
import { site } from "../../site-config"
import { faqItems as items } from "../../structured-data"
---

{
  items.length > 0 && (
    <section class="band faq">
      <div class="wrap faq-inner">
        {site.faqHeading && (
          <div class="section-head">
            <h2>{site.faqHeading}</h2>
          </div>
        )}
        <div class="faq-list">
          {items.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

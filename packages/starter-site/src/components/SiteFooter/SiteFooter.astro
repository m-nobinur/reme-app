---
import { navLinks } from "../../routes"
import { site } from "../../site-config"
import ContactDetails from "../ContactDetails/ContactDetails.astro"

const hasContact = Boolean(
  site.phone || site.email || site.weekdayHours || site.serviceArea
)
---

{
  (site.businessName || hasContact || navLinks.length > 0) && (
    <footer class="site-footer">
      <div class="wrap footer-grid">
        {site.businessName && <p class="site-name">{site.businessName}</p>}
        <ContactDetails />
        {navLinks.length > 0 && (
          <nav aria-label={site.footerNavLabel}>
            <ul>
              {navLinks.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </div>
    </footer>
  )
}

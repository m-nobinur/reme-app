---
import Photo from "../../layouts/Photo.astro"
import { navLinks, primaryAction } from "../../routes"
import { site } from "../../site-config"
import ActionLink from "../ActionLink/ActionLink.astro"
import ContactDetails from "../ContactDetails/ContactDetails.astro"

const hasContact = Boolean(
  site.phone ||
    site.email ||
    site.weekdayHours ||
    site.serviceAreaText ||
    site.serviceArea
)
const blurb = site.tagline || site.homeIntro
---

{
  (site.businessName || hasContact || navLinks.length > 0) && (
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div class="footer-brand">
          {site.logo && site.logoAlt ? (
            <p class="site-name">
              <Photo class="site-logo" src={site.logo} alt={site.logoAlt} widths={[160, 320, 480]} sizes="160px" />
            </p>
          ) : (
            site.businessName && (
              <p class="site-name footer-name">
                <img
                  class="footer-mark"
                  src="/favicon.svg"
                  alt=""
                  width="32"
                  height="32"
                  loading="lazy"
                  decoding="async"
                />
                {site.businessName}
              </p>
            )
          )}
          {blurb && <p class="footer-blurb">{blurb}</p>}
          {primaryAction && (
            <ActionLink
              href={primaryAction.href}
              label={primaryAction.label}
              variant="secondary"
            />
          )}
        </div>
        {navLinks.length > 0 && (
          <nav aria-label={site.footerNavLabel}>
            {site.footerPagesHeading && (
              <h2 class="footer-heading">{site.footerPagesHeading}</h2>
            )}
            <ul>
              {navLinks.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        {hasContact && (
          <div class="footer-contact">
            {site.footerContactHeading && (
              <h2 class="footer-heading">{site.footerContactHeading}</h2>
            )}
            <ContactDetails />
          </div>
        )}
      </div>
      {site.disclaimer && (
        <div class="wrap">
          <p class="footer-disclaimer">{site.disclaimer}</p>
        </div>
      )}
      {site.businessName && (
        <div class="wrap">
          <p class="footer-base">
            © {site.businessName}
          </p>
        </div>
      )}
    </footer>
  )
}

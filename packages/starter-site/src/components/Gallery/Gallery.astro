---
import Photo from "../../layouts/Photo.astro"
import SectionHead from "../../layouts/SectionHead.astro"
import { pageFields } from "../../page-fields"
import { hasPhoto } from "../../photo-files"
import { site } from "../../site-config"

interface Props {
  /** The short label above the h2; empty is the galleryEyebrow slot's default. */
  eyebrow?: string
  /** The h2; empty is the galleryHeading slot's default. */
  heading?: string
}

const {
  eyebrow = pageFields.galleryEyebrow,
  heading = pageFields.galleryHeading,
} = Astro.props

// The path names a file a gallery image slot placed and the alt text says what
// it shows. A photo with no alt text does not render.
const items = ([1, 2, 3] as const)
  .map((n) => ({ src: site[`photo${n}Src`], alt: site[`photo${n}Alt`] }))
  .filter((item) => item.alt && hasPhoto(item.src))
---

{
  items.length > 0 && (
    <section class="band gallery">
      <div class="wrap">
      <SectionHead eyebrow={eyebrow} heading={heading} />
      {items.length === 1 ? (
        <figure class="gallery-single">
          <Photo
            src={items[0]?.src ?? ""}
            alt={items[0]?.alt ?? ""}
            sizes="(min-width: 48rem) 44rem, 100vw"
          />
        </figure>
      ) : (
        <ul class:list={["gallery-grid", `gallery-${items.length}`]}>
          {items.map((item) => (
            <li>
              <Photo src={item.src} alt={item.alt} sizes="(min-width: 64rem) 33vw, 100vw" />
            </li>
          ))}
        </ul>
      )}
      </div>
    </section>
  )
}

---
import { site } from "../../site-config"

// Both halves are facts: the path names a file the owner supplied and the alt
// text says what it shows. A photo with no alt text does not render.
const items = ([1, 2, 3] as const)
  .map((n) => ({ src: site[`photo${n}Src`], alt: site[`photo${n}Alt`] }))
  .filter((item) => item.src && item.alt)
---

{
  items.length > 0 && (
    <section class="band gallery">
      <div class="wrap">
      {site.galleryHeading && (
        <div class="section-head">
          <h2>{site.galleryHeading}</h2>
        </div>
      )}
      {items.length === 1 ? (
        <figure class="gallery-single">
          <img
            src={items[0]?.src}
            alt={items[0]?.alt}
            loading="lazy"
            decoding="async"
          />
        </figure>
      ) : (
        <ul class:list={["gallery-grid", `gallery-${items.length}`]}>
          {items.map((item) => (
            <li>
              <img src={item.src} alt={item.alt} loading="lazy" decoding="async" />
            </li>
          ))}
        </ul>
      )}
      </div>
    </section>
  )
}

---
import "../styles/tokens.css"
import "../styles/theme.css"
import "../styles/site.css"
import { Font } from "astro:assets"
import { brandTheme } from "../brand"
import Seo from "../components/Seo/Seo.astro"
import SiteFooter from "../components/SiteFooter/SiteFooter.astro"
import SiteHeader from "../components/SiteHeader/SiteHeader.astro"
import { BODY_VAR, DISPLAY_VAR, fontTheme, pairOf } from "../fonts"
import { templateOf } from "../presets"
import { site } from "../site-config"

interface Props {
  title: string
  description?: string
  jsonLd?: Record<string, unknown>[]
  noindex?: boolean
}

const props = Astro.props
// Empty unless the owner chose a colour, and empty again if what they chose is
// not a hex colour. See src/brand.ts. The font rule likewise, from src/fonts.ts.
const pair = pairOf(site.font)
const theme = brandTheme(site.brandColor) + fontTheme(pair)
---

<html lang="en" data-template={templateOf(site.template)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {...props} />
    {theme && <style is:inline set:html={theme} />}
    {
      pair && (
        <>
          {/* The display face is on screen at once, so it is preloaded; the body face is not.
              The variable names come from a computed config, so Astro's generated
              CssVariable type is `never`; the cast is the whole workaround. */}
          <Font
            cssVariable={DISPLAY_VAR as never}
            preload={[{ weight: pair.display.weights[0], style: "normal" }]}
          />
          <Font cssVariable={BODY_VAR as never} />
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{site.skipLink}</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

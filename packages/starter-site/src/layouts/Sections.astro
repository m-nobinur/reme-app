---
// A page's body, from its document (src/documents.ts): each section in order,
// its words and blocks from the document. The page file keeps what is its own
// (title, description, structured data); everything a section says is data.
import { plain } from "../accent"
import { areaDeep, areaTowns } from "../area-map"
import ActionLink from "../components/ActionLink/ActionLink.astro"
import AreaSection from "../components/AreaSection/AreaSection.astro"
import ContactDetails from "../components/ContactDetails/ContactDetails.astro"
import CtaBand from "../components/CtaBand/CtaBand.astro"
import Faq from "../components/Faq/Faq.astro"
import Gallery from "../components/Gallery/Gallery.astro"
import Hero from "../components/Hero/Hero.astro"
import QuoteForm from "../components/QuoteForm/QuoteForm.astro"
import Section from "../components/Section/Section.astro"
import ServiceCards from "../components/ServiceCards/ServiceCards.astro"
import Steps from "../components/Steps/Steps.astro"
import Testimonials from "../components/Testimonials/Testimonials.astro"
import TrustStrip from "../components/TrustStrip/TrustStrip.astro"
import ValueProps from "../components/ValueProps/ValueProps.astro"
import { directionOf } from "../directions"
import { pageDocument } from "../documents"
import { headerPhoto } from "../header-photo"
import type { Block, PageSection } from "../page-document"
import type { Page } from "../page-seed"
import { phoneText } from "../phone"
import { hasRoute, primaryAction } from "../routes"
import { site } from "../site-config"
import { type ServiceItem, serviceItems } from "../structured-data"
import AboutSection from "./AboutSection.astro"
import AreaArt from "./AreaArt.astro"
import Blocks from "./Blocks.astro"
import Markdown from "./Markdown.astro"
import SectionHead from "./SectionHead.astro"

interface Props {
  page: Page
  /** On a service's own page (page "service"), the service it is about. */
  service?: ServiceItem
}

const { page, service } = Astro.props
const doc = pageDocument(page, service?.slug)
// The custom sections the builder wrote, by name: a document naming one that
// is not there fails the build rather than leave a hole in the page.
const CUSTOM = import.meta.glob<{ default: (props: PageSection) => unknown }>(
  "../components/custom/*.astro",
  { eager: true }
)
const custom = (name: string) => {
  const found = CUSTOM[`../components/custom/${name}.astro`]
  if (!found)
    throw new Error(
      `the ${page} page's document places the custom section ${name}, and src/components/custom/${name}.astro does not exist`
    )
  return found.default
}
const first = <T extends Block["type"]>(section: PageSection, type: T) =>
  (section.blocks ?? []).find(
    (b): b is Extract<Block, { type: T }> => b.type === type
  )
// An inner page's header shows its own photo when the build has one, in the
// hero's photo form; without one it is the plain text header.
const pagePhoto = headerPhoto(service ? `service:${service.id}` : page)
const home = page === "home"
// The service area page's header is a cover with the area drawn beside it.
const areaCover = page === "service_area" && !pagePhoto
// Offerings are work beyond the service rows; a line that only repeats a
// service's name would list the same services twice on one page.
const named = new Set(
  [1, 2, 3, 4, 5, 6].map((n) =>
    String(site[`service${n}Name` as keyof typeof site] ?? "")
      .trim()
      .toLowerCase()
  )
)
const offerings = site.offerings
  .split("\n")
  .map((item) => item.trim())
  .filter((item) => item && !named.has(item.toLowerCase()))
const talk = site.phone || site.email
// The services page's comparison table says what each service covers once.
const tabled = (doc?.sections ?? []).some((section) =>
  (section.blocks ?? []).some((block) => block.type === "table")
)

// A section with no variant of its own takes the direction's; a page hero
// other than home's stays the plain one. Each component types its own
// variants and a test checks the documents' and the directions' strings
// against the contract, so one cast stands for all of them.
const direction = directionOf(site.direction)
const OF_DIRECTION: Partial<Record<string, string>> = {
  hero: home ? direction.hero : undefined,
  service_cards: direction.services,
  steps: direction.steps,
  faq: direction.faq,
  cta_band: direction.cta,
}
---

{
  (doc?.sections ?? []).map((section) => {
    const v = (("variant" in section && section.variant) ||
      OF_DIRECTION[section.kind]) as never
    const heading = section.heading ?? ""
    // A heading with no label of its own takes its slot's; no heading needs none.
    const eyebrow = section.eyebrow || (heading ? undefined : "")
    const intro = section.intro ?? ""
    switch (section.kind) {
      case "hero": {
        const note = first(section, "callout")?.text ?? ""
        return (
          <Hero
            variant={pagePhoto ? (v ?? "split_frame") : v}
            inner={!home}
            eyebrow={home ? eyebrow || site.industry : ""}
            heading={plain(heading)}
            lede={intro}
            image={
              home
                ? { src: site.heroImage, alt: site.heroImageAlt }
                : pagePhoto
            }
            caption={home ? site.heroCaption : ""}
            highlights={home ? serviceItems.slice(0, 3) : []}
            note={home ? note : ""}
            deep={areaCover && areaDeep(site.direction)}
          >
            {areaCover && (
              <AreaArt
                slot="art"
                class="area-art-cover"
                towns={areaTowns(site.areaTowns)}
                seed={site.serviceAreaText}
              />
            )}
            {home && primaryAction && (
              <ActionLink href={primaryAction.href} label={primaryAction.label} />
            )}
            {home && site.phone && (
              <ActionLink
                href={`tel:${site.phone}`}
                label={phoneText(site.phone)}
                variant="secondary"
              />
            )}
          </Hero>
        )
      }
      case "trust_strip":
        return <TrustStrip variant={v} />
      case "service_cards": {
        const help = first(section, "prose")
        return (
          <>
            <ServiceCards
              variant={v}
              only={service?.id}
              eyebrow={eyebrow}
              heading={heading}
              bodies={!(page === "services" && tabled)}
            />
            {page === "services" && help?.markdown && (
              <Section eyebrow={help.eyebrow ?? ""} heading={help.heading ?? ""}>
                <Markdown source={help.markdown} copy="services_help" />
                {primaryAction && (
                  <p class="section-more">
                    <a class="more-link" href={primaryAction.href}>
                      {primaryAction.label}
                    </a>
                  </p>
                )}
              </Section>
            )}
            {page === "services" && offerings.length > 0 && (
              <Section
                eyebrow={site.offeringsEyebrow}
                heading={site.offeringsHeading}
              >
                <ol class="offerings">
                  {offerings.map((item) => (
                    <li>{item}</li>
                  ))}
                </ol>
              </Section>
            )}
          </>
        )
      }
      case "value_props":
        return (
          <ValueProps
            variant={v}
            eyebrow={eyebrow}
            heading={heading}
            items={(first(section, "cards")?.items ?? []).map((item) => ({
              ...item,
              icon: item.icon ?? "",
            }))}
            copy={page === "about" ? "approach_body" : undefined}
          />
        )
      case "steps":
        return (
          <Steps
            variant={v}
            eyebrow={eyebrow}
            heading={heading}
            items={first(section, "steps")?.items ?? []}
          />
        )
      case "about":
        return (
          <AboutSection
            page={home ? "home" : "about"}
            section={section}
            variant={v}
          />
        )
      case "testimonials":
        return <Testimonials variant={v} eyebrow={eyebrow} heading={heading} />
      case "gallery":
        return <Gallery eyebrow={eyebrow} heading={heading} />
      case "service_area":
        return (
          <AreaSection
            variant={v}
            eyebrow={eyebrow}
            heading={heading}
            body={intro}
          />
        )
      case "faq":
        return (
          <Faq
            variant={v}
            eyebrow={eyebrow}
            heading={heading}
            intro={intro}
            items={first(section, "faq")?.items ?? []}
          />
        )
      case "cta_band": {
        const cta = first(section, "cta")
        return (
          <CtaBand
            variant={v}
            eyebrow={section.eyebrow || undefined}
            heading={cta?.heading ?? ""}
            body={cta?.body ?? ""}
            label={cta?.label || site.ctaLabel}
          />
        )
      }
      case "contact": {
        const note = first(section, "prose")
        return (
          <>
            <section class="band">
              <div class="wrap">
                <ContactDetails variant="cards" />
              </div>
            </section>
            {note?.markdown && (
              <Section
                eyebrow={(note.heading ? note.eyebrow : eyebrow) ?? ""}
                heading={note.heading || heading}
              >
                <Markdown source={note.markdown} copy="contact_body" />
                {hasRoute("/quote/") && site.contactFormLink && (
                  <p class="section-more">
                    <a class="more-link" href="/quote/">
                      {site.contactFormLink}
                    </a>
                  </p>
                )}
              </Section>
            )}
          </>
        )
      }
      case "quote_form": {
        // The quote form sends by email until the platform has an endpoint
        // for it; see QuoteForm. Beside it, what happens next and the
        // business's own phone and email. A response time shows only when a
        // fact gives one.
        const next = (first(section, "checklist")?.items ?? []).filter(Boolean)
        return (
          <section class="band">
            <div class="wrap quote-layout">
              <QuoteForm />
              {(next.length > 0 || talk) && (
                <aside class="quote-aside">
                  {next.length > 0 && (
                    <>
                      <SectionHead eyebrow={eyebrow} heading={heading} />
                      <ol class="next-list">
                        {next.map((line) => (
                          <li>{line}</li>
                        ))}
                      </ol>
                    </>
                  )}
                  {talk && (
                    <>
                      <SectionHead
                        eyebrow={next.length > 0 ? "" : eyebrow}
                        heading={site.quoteTalkHeading}
                      />
                      <ContactDetails />
                    </>
                  )}
                </aside>
              )}
            </div>
          </section>
        )
      }
      case "content":
        return (
          (heading || intro || (section.blocks ?? []).length > 0) && (
            <section class="band section content-section" id={section.id}>
              <div class="wrap section-inner">
                <SectionHead eyebrow={eyebrow} heading={heading} />
                <div class="section-body">
                  {intro && <p class="section-lede">{intro}</p>}
                  <Blocks blocks={section.blocks ?? []} />
                </div>
              </div>
            </section>
          )
        )
      case "custom": {
        const Custom = custom(section.name)
        return <Custom {...section} />
      }
    }
  })
}

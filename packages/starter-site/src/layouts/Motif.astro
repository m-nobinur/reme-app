---
// A line-art ornament a section may draw beside its copy, only where it
// means something: a map pin in rings beside the service area. Decoration
// only, so it is hidden from assistive technology, and drawn in hairlines of
// the palette: currentColor (site.css sets it from the brand line), the pin in
// the brand's text colour.
interface Props {
  kind: "pin"
  class?: string
}

const { kind, class: className } = Astro.props
---

<svg
  class:list={["motif", `motif-${kind}`, className]}
  viewBox="0 0 240 240"
  fill="none"
  stroke="currentColor"
  stroke-width="1"
  aria-hidden="true"
  focusable="false"
>
  {
    kind === "pin" && (
      <>
        <circle cx="120" cy="128" r="104" stroke-dasharray="2 6" />
        <circle cx="120" cy="128" r="76" />
        <circle cx="120" cy="128" r="46" />
        <path
          class="motif-pin-shape"
          d="M120 76c-17.7 0-32 14.3-32 32 0 24 32 52 32 52s32-28 32-52c0-17.7-14.3-32-32-32Z"
        />
        <circle class="motif-pin-dot" cx="120" cy="108" r="10" />
      </>
    )
  }
</svg>

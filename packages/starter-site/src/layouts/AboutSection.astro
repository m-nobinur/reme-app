---
import { accentParts } from "../accent"
import Icon from "../components/Icon/Icon.astro"
import Section from "../components/Section/Section.astro"
import { headerPhoto } from "../header-photo"
import type { PageSection } from "../page-document"
import { hasPhoto } from "../photo-files"
import { hasRoute } from "../routes"
import { site } from "../site-config"
import Blocks from "./Blocks.astro"
import Markdown from "./Markdown.astro"
import Photo from "./Photo.astro"
import SectionHead from "./SectionHead.astro"

interface Props {
  /** The home page's short about section, or the about page's story and proof. */
  page: "home" | "about"
  /**
   * The page document's about section. On the about page its intro is the
   * story, its `<id>-audience` block who the business serves and its
   * `<id>-record` block the record beside the proof points; any other block
   * follows the story.
   */
  section: PageSection
}

const { page, section } = Astro.props
const blocks = section.blocks ?? []
const named = (what: string) =>
  blocks.find((b) => b.id === `${section.id}-${what}`)
const prose = (block: (typeof blocks)[number] | undefined) =>
  block?.type === "prose" ? block : undefined
const story = section.intro ?? ""
const audience = prose(named("audience"))
const record = prose(named("record"))
const others = blocks.filter((b) => b !== audience && b !== record)
// The story's photo: the owner's first gallery photo or none. Never the home
// hero's, which the home page already shows, and none on an About page whose
// header already opens on a photo: two photos stacked read as one twice.
// Both halves or none.
const photo =
  site.photo1Alt &&
  hasPhoto(site.photo1Src) &&
  !(page === "about" && headerPhoto("about"))
    ? { src: site.photo1Src, alt: site.photo1Alt }
    : undefined
// The record's items: the stated figures, then the points. A band with a lone
// sentence says nothing the trust strip does not, so it needs two items.
const proofItems = [
  ...[
    [site.statYearsValue, site.statYearsLabel],
    [site.statClientsValue, site.statClientsLabel],
    [site.statRatingValue, site.statRatingLabel],
  ]
    .filter(([value]) => value)
    .map(([value, label]) => `${value} ${label?.toLowerCase()}`.trim()),
  ...[site.trust1, site.trust2, site.trust3].filter(Boolean),
]
// The audience h3 reads the same accent marks as the h2 above it.
const audienceHead = accentParts(audience?.heading ?? "")
---

{
  page === "home" ? (
    (story || blocks.length > 0) && (
      <Section eyebrow={section.eyebrow ?? ""} heading={section.heading ?? ""}>
        {story && <p class="section-lede">{story}</p>}
        {blocks.map((block) =>
          block.type === "prose" ? (
            <Markdown source={block.markdown} />
          ) : (
            <Blocks blocks={[block]} />
          )
        )}
        {hasRoute("/about/") && site.aboutLink && (
          <p class="section-more">
            <a class="more-link" href="/about/">
              {site.aboutLink}
            </a>
          </p>
        )}
      </Section>
    )
  ) : (
    <>
      {(story || audience?.markdown || others.length > 0) && (
        <section class="band about-story">
          <div class:list={["wrap", "story-inner", photo && "story-split"]}>
            <div class="story-text">
              <SectionHead
                eyebrow={section.eyebrow ?? ""}
                heading={section.heading ?? ""}
              />
              {
                story && (
                  <p class="section-lede" data-copy="about_body">
                    {story}
                  </p>
                )
              }
              {audience?.markdown && audience.heading && (
                <h3>
                  {audienceHead.lead}
                  {audienceHead.accent && (
                    <span class="accent">{audienceHead.accent}</span>
                  )}
                  {audienceHead.tail}
                </h3>
              )}
              {audience?.markdown && (
                <Markdown source={audience.markdown} copy="about_body" />
              )}
              {others.length > 0 && <Blocks blocks={others} />}
            </div>
            {photo && (
              <Photo
                class="story-photo"
                src={photo.src}
                alt={photo.alt}
                sizes="(min-width: 80rem) 36rem, (min-width: 56rem) 50vw, 100vw"
              />
            )}
          </div>
        </section>
      )}
      {proofItems.length >= 2 && (
        <Section eyebrow={record?.eyebrow ?? ""} heading={record?.heading ?? ""}>
          <div class="proof-record">
            {record?.markdown && (
              <Markdown
                source={record.markdown}
                copy={record.provenance === "owner" ? undefined : "proof_body"}
              />
            )}
            <ul class="check-list">
              {proofItems.map((item) => (
                <li>
                  <Icon name="checkCircle" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </Section>
      )}
    </>
  )
}

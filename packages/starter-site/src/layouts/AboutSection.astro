---
import { accentParts } from "../accent"
import Icon from "../components/Icon/Icon.astro"
import Section from "../components/Section/Section.astro"
import { headerPhoto } from "../header-photo"
import { hasPhoto } from "../photo-files"
import { hasRoute } from "../routes"
import { site } from "../site-config"
import Photo from "./Photo.astro"
import SectionHead from "./SectionHead.astro"

interface Props {
  /** The home page's short about section, or the about page's story and proof. */
  page: "home" | "about"
}

const { page } = Astro.props
const story = site.overviewBody || site.overview
const audience = site.audienceBody || site.audience
// The copy gate counts proofBody, the writer's paragraph, never proof as given.
const proof = site.proofBody || site.proof
// Without an about page, the home page's section says who the business
// serves too.
const homeAudience =
  !hasRoute("/about/") && (site.audienceBody || site.audience)
const homeAbout = site.aboutIntro || site.overviewBody || site.overview
// The story's photo: the owner's first gallery photo or none. Never the home
// hero's, which the home page already shows, and none on an About page whose
// header already opens on a photo: two photos stacked read as one twice.
// Both halves or none.
const photo =
  site.photo1Alt &&
  hasPhoto(site.photo1Src) &&
  !(page === "about" && headerPhoto("about"))
    ? { src: site.photo1Src, alt: site.photo1Alt }
    : undefined
// The record's items: the stated figures, then the points. A band with a lone
// sentence says nothing the trust strip does not, so it needs two items.
const proofItems = [
  ...[
    [site.statYearsValue, site.statYearsLabel],
    [site.statClientsValue, site.statClientsLabel],
    [site.statRatingValue, site.statRatingLabel],
  ]
    .filter(([value]) => value)
    .map(([value, label]) => `${value} ${label?.toLowerCase()}`.trim()),
  ...[site.trust1, site.trust2, site.trust3].filter(Boolean),
]
const storyHeading = story ? site.overviewHeading : site.audienceHeading
// The audience h3 reads the same accent marks as the h2 above it.
const audienceHead = accentParts(site.audienceHeading)
---

{
  page === "home" ? (
    (homeAbout || homeAudience) && (
      <Section
        eyebrow={site.aboutEyebrow}
        heading={site.homeAboutHeading || site.aboutHeading}
      >
        {site.homeIntro && site.tagline && (
          <p class="section-lede">{site.tagline}</p>
        )}
        {homeAbout && <p>{homeAbout}</p>}
        {homeAudience && <p>{homeAudience}</p>}
        {hasRoute("/about/") && site.aboutLink && (
          <p class="section-more">
            <a class="more-link" href="/about/">
              {site.aboutLink}
            </a>
          </p>
        )}
      </Section>
    )
  ) : (
    <>
      {(story || audience) && (
        <section class="band about-story">
          <div class:list={["wrap", "story-inner", photo && "story-split"]}>
            <div class="story-text">
              <SectionHead
                eyebrow={site.overviewEyebrow}
                heading={storyHeading}
              />
              {
                story && (
                  <p class="section-lede" data-copy="about_body">
                    {story}
                  </p>
                )
              }
              {story && audience && site.audienceHeading && (
                <h3>
                  {audienceHead.lead}
                  {audienceHead.accent && (
                    <span class="accent">{audienceHead.accent}</span>
                  )}
                  {audienceHead.tail}
                </h3>
              )}
              {audience && <p data-copy="about_body">{audience}</p>}
            </div>
            {photo && (
              <Photo
                class="story-photo"
                src={photo.src}
                alt={photo.alt}
                sizes="(min-width: 80rem) 36rem, (min-width: 56rem) 50vw, 100vw"
              />
            )}
          </div>
        </section>
      )}
      {proofItems.length >= 2 && (
        <Section eyebrow={site.proofEyebrow} heading={site.proofHeading}>
          <div class="proof-record">
            {proof && (
              <p data-copy={site.proofBody ? "proof_body" : undefined}>
                {proof}
              </p>
            )}
            <ul class="check-list">
              {proofItems.map((item) => (
                <li>
                  <Icon name="checkCircle" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </Section>
      )}
    </>
  )
}

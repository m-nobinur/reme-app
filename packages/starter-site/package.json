{
  "name": "@workspace/starter-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "typecheck": "astro check",
    "test": "astro build && node ../../scripts/floor.mjs starter-site -- vitest run --dir test",
    "test:a11y": "node ../../scripts/floor.mjs starter-site-a11y -- vitest run --dir a11y",
    "size": "node scripts/size.mjs",
    "manifests": "node scripts/manifests.ts && biome format --write manifests.json",
    "check:drift": "pnpm manifests && git diff --exit-code -- manifests.json src/components"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/figtree": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@fontsource/sora": "5.3.0",
    "@fontsource/syne": "5.3.0",
    "@fontsource/work-sans": "5.3.0",
    "astro": "7.4.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22",
    "@workspace/contracts": "workspace:*",
    "parse5": "8.0.1",
    "schema-dts": "2.1.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.5",
    "yaml": "2.9.1"
  },
  "exports": {
    "./site-config": "./src/site-config.ts",
    "./brand": "./src/brand.ts",
    "./copy-check": "./src/copy-check.ts",
    "./icons": "./src/icons.ts",
    "./manifests.json": "./manifests.json",
    "./size-budget.json": "./size-budget.json",
    "./directions.json": "./src/directions.json"
  }
}

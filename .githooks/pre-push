#!/usr/bin/env bash
. "$(dirname "$0")/_lib.sh"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  target=${remote_ref#refs/heads/}
  [[ "$target" =~ $PROTECTED_BRANCHES ]] && \
    die "direct push to '$target' is not allowed. Open a PR:  gh pr create --fill"
done

# The rest is heavy: wait for any other heavy job on this machine, holding its lock.
[ -n "${REME_HEAVY_LOCK:-}" ] || exec "$(dirname "$0")/../scripts/heavy.sh" "$0" "$@" </dev/null

# Turbo's cache is shared by every worktree on this machine, and it hashes
# declared inputs, not what is installed. A cached pass once replayed while
# packages/db/node_modules was gone (#11). So the install is checked first: a
# frozen install puts back what is missing or refuses. A cached result is then
# one this tree would produce only if every file a task reads is in its
# inputs, so a suite that reads outside its package names those files in
# turbo.json. `@workspace/ui#test` is never cached; turbo.json says why.
printf '  → pnpm install --frozen-lockfile --prefer-offline\n' >&2
if ! out=$(pnpm install --frozen-lockfile --prefer-offline 2>&1); then
  printf '%s\n' "$out" >&2
  die "pnpm install --frozen-lockfile failed. Fix the install before pushing."
fi

# Only the packages this branch changes and their dependents, against the
# merge-base with origin/main (or a TURBO_SCM_BASE you set, for a stacked
# branch). Without that ref, everything.
export TURBO_SCM_BASE=${TURBO_SCM_BASE:-origin/main}
affected=
if git rev-parse -q --verify "$TURBO_SCM_BASE^{commit}" >/dev/null; then
  affected=--affected
else
  warn "  ↷ $TURBO_SCM_BASE not found: checking every package"
fi
# shellcheck disable=SC2086 # empty means no argument
run_script typecheck $affected
# shellcheck disable=SC2086
run_script test $affected
ok "✓ pre-push"

{
  "name": "api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "cf-typegen": "wrangler types --env-file /dev/null",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/floor.mjs api-unit -- vitest run --dir test",
    "test:tenancy": "node ../../scripts/floor.mjs api-tenancy -- vitest run --dir tenancy",
    "size": "node ../../scripts/size.mjs api --forbid abandoned-head-element-child"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@workos-inc/node": "10.11.0",
    "@workspace/contracts": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/facade": "workspace:*",
    "@workspace/gates": "workspace:*",
    "@workspace/starter-site": "workspace:*",
    "ai": "7.0.123"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24",
    "iron-webcrypto": "2.0.0",
    "typescript": "^6",
    "vitest": "^4.1.11",
    "wrangler": "4.144.0"
  }
}

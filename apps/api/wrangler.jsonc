{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reme-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  // Required for a Postgres driver: the socket support Hyperdrive connects
  // through comes from the Node compatibility layer.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Minified because the `ai` runtime the chief of staff brings measured 465.60
  // KiB gzip unminified against 324.91 minified. Measured on this change alone
  // with `pnpm size`: 296.21 KiB gzip (1660.51 raw) before, 207.37 (856.09)
  // after. `keep_names` defaults to true for a deploy, so classes keep their
  // `name`, which `postgres` and `jose` copy into `error.name` through
  // `this.constructor.name`. The source map is uploaded so stack traces in
  // Workers Logs map back to `src/`; it does not count toward the bundle size.
  "minify": true,
  "upload_source_maps": true,
  // The worker runs next to the database, not next to the reader. Measured on
  // staging before this line existed: `/staff` p95 3499 ms from Dhaka against a
  // database in eu-central-1, with `cpuTime` 6 to 45 ms. So it was never
  // compute and never the reader's own link, which answers `/nope` in 30 ms. It
  // was `withOrg` issuing five sequential statements plus a connection
  // handshake, each paying a Dhaka to Frankfurt round trip.
  //
  // A read is one request from the reader and many to Postgres, which is the
  // shape placement exists for. Revisit if the database moves or if a read ever
  // fans out to something the reader is closer to than Frankfurt.
  //
  // Measured after, on the deployed worker: server-side `wallTime` p50 67 ms,
  // p95 98 ms, against p50 1729 to 2025 ms before. From a Dhaka client the
  // database's own share, taken as the difference between `/health` and the
  // `/nope` route that touches no database, is p50 59 ms and p95 41 ms; the
  // ~340 ms that remains in a client-side reading is that client's own leg to
  // Frankfurt and no configuration moves it.
  "placement": { "region": "aws:eu-central-1" },
  // Explicit rather than inherited. The default has changed three times: before
  // wrangler 4.34 preview URLs were always on, 4.34 to 4.44 always off, and
  // 4.44 or later matches `workers_dev`. Preview environments per PR are
  // `wrangler versions upload --preview-alias`, so a wrangler upgrade that
  // moved this default again would take every preview URL down with it. Load
  // bearing now that `workers_dev` is off: the default follows it.
  "preview_urls": true,
  // The hostname is ADR-030's. `custom_domain: true` makes wrangler create and
  // own the DNS record and the certificate. `workers_dev` is off so the Worker
  // answers in one place; measured 2026-09-14 that preview aliases survive it.
  "workers_dev": false,
  // The zone route keeps staging off the production site router, as the
  // production block below explains.
  "routes": [
    { "pattern": "staging-api.remeai.co.uk", "custom_domain": true },
    { "pattern": "staging-api.remeai.co.uk/*", "zone_name": "remeai.co.uk" }
  ],
  // `reme-staging-postgres`, created by `node infra/bootstrap.ts staging`. It
  // connects as `reme_app`, which has no BYPASSRLS, so the policies are
  // evaluated against the connecting role and the `SET LOCAL ROLE` inside
  // `withOrg` is the second layer rather than the only one. Query caching is
  // off: Hyperdrive keys its cache on the query and its parameters, and the
  // org context is in neither, so two tenants would share a cache entry.
  //
  // `wrangler dev` never reads the id. It connects to whatever
  // `CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE` holds, which is
  // how this runs against a local Postgres with no Cloudflare resource in
  // existence; `pnpm dev` fills it from `DATABASE_URL`. The sibling
  // `localConnectionString` field would do the same job and is not used,
  // because a connection string in a committed file is a password in a
  // committed file (R9), and the secret scan refuses it.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "51fda187d78445c6852dbc334d9ac7ed"
    }
  ],
  // The owner's way to the builder (ADR-032 amendment): the orchestrator's
  // named `OwnerApi` entrypoint, which no route, custom domain or version URL
  // can reach. A preview version of this Worker binds the deployed
  // orchestrator, never the pull request's copy, because nothing here sends a
  // version override.
  "services": [
    {
      "binding": "ORCHESTRATOR",
      "service": "reme-orchestrator",
      "entrypoint": "OwnerApi"
    }
  ],
  // The suffix the router serves sites on (ADR-030), for the live site's host
  // in `/workspace`. The orchestrator and the router carry the same value.
  "vars": {
    "SITE_HOST_SUFFIX": "-stg.remeai.co.uk",
    // Where Checkout sends an owner back after a redirect-based payment.
    "WEB_ORIGIN": "https://staging.remeai.co.uk",
    // The domain an owner's emailed reply is addressed to (src/inbound-email.ts).
    // The apex `remeai.co.uk` instead if Email Routing cannot route plus
    // addresses on the subdomain; the orchestrator carries the same value.
    "REPLY_DOMAIN": "reply.remeai.co.uk"
  },
  // The orchestrator's site bucket. The api writes only the owner's photos,
  // under `uploads/{org_id}/{asset_id}`, and the orchestrator copies them into
  // the build's sandbox.
  "r2_buckets": [{ "binding": "SITES", "bucket_name": "reme-sites" }],
  // The scheduler's earliest due job, shared with the orchestrator, whose cron
  // reads it. The api only lowers it, after the commit that wrote a job
  // (ADR-043).
  "kv_namespaces": [
    { "binding": "SCHEDULE", "id": "REPLACE_WITH_reme-schedule_ID" }
  ],
  // Resizes generated photos to thumbnails in `GET /photos/:id`. Local
  // `wrangler dev` runs a low-fidelity offline version (width and format).
  "images": { "binding": "IMAGES" },
  // Each signed-in person's writes a minute; the number is argued in
  // src/limit.ts and a test holds this block to it. `period` takes 10 or 60.
  // A `namespace_id` is shared by every binding in the account that names it,
  // counters and all, so this one is its own: 1001 is the web's sign-in
  // limit, 1002 the router's misses, 1004 production's copy of this one.
  "ratelimits": [
    {
      "name": "WRITE_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  // Closed turns, for the work that follows one (compaction, reflection). A
  // message holds ids only, so a consumer never carries a conversation's text.
  // The first attempt and three retries, then the dead-letter queue, where a
  // poisoned job waits to be read instead of retrying forever.
  "queues": {
    "producers": [{ "binding": "AFTER_TURN", "queue": "reme-after-turn" }],
    "consumers": [
      {
        "queue": "reme-after-turn",
        "max_retries": 3,
        "dead_letter_queue": "reme-after-turn-dlq"
      }
    ]
  },
  // Production. Everything above is staging, which is what the default
  // environment has always been; naming that is a later cleanup.
  //
  // Bindings do not inherit, so the Hyperdrive config is declared again and
  // points at `reme-prod-postgres`, which fronts the `reme-prod` Neon project
  // rather than a branch of the staging one (ADR-030's sibling reasoning: a
  // branch would have arrived holding the golden fixtures). Placement,
  // compatibility flags and observability do inherit.
  "env": {
    "production": {
      "name": "reme-api-production",
      // Off, unlike staging: preview aliases exist for the per-PR flow, and a
      // production Worker has no per-PR flow. Fewer URLs answering as prod.
      "preview_urls": false,
      "workers_dev": false,
      // The second entry keeps this hostname off the site router. Its route is
      // `*/*` (ADR-041), and a wildcard route beats a custom domain, so
      // without this every request here would pass through that Worker first.
      // An explicit host route beats the wildcard (measured 2026-09-18 with two
      // throwaway Workers, 6 of 6). The router's `SERVICE_HOSTS` stays as the
      // net under it (issue #90, ADR-030).
      "routes": [
        { "pattern": "api.remeai.co.uk", "custom_domain": true },
        { "pattern": "api.remeai.co.uk/*", "zone_name": "remeai.co.uk" }
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "42db5d04bb0e4249b3e5a88e62549218"
        }
      ],
      // Bindings and vars do not inherit either.
      "services": [
        {
          "binding": "ORCHESTRATOR",
          "service": "reme-orchestrator-production",
          "entrypoint": "OwnerApi"
        }
      ],
      "vars": {
        "SITE_HOST_SUFFIX": ".remeai.co.uk",
        "WEB_ORIGIN": "https://preview.remeai.co.uk",
        "REPLY_DOMAIN": "reply.remeai.co.uk"
      },
      "images": { "binding": "IMAGES" },
      "r2_buckets": [
        {
          "binding": "SITES",
          "bucket_name": "reme-sites-production-eu",
          "jurisdiction": "eu"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "SCHEDULE",
          "id": "REPLACE_WITH_reme-schedule-production_ID"
        }
      ],
      // Its own namespace: staging and production people share one WorkOS
      // environment until the split, so a shared id would share their counts.
      "ratelimits": [
        {
          "name": "WRITE_LIMIT",
          "namespace_id": "1004",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      "queues": {
        "producers": [
          { "binding": "AFTER_TURN", "queue": "reme-after-turn-production" }
        ],
        "consumers": [
          {
            "queue": "reme-after-turn-production",
            "max_retries": 3,
            "dead_letter_queue": "reme-after-turn-dlq-production"
          }
        ]
      }
    }
  }
}

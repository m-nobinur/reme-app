{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reme-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  // Required for a Postgres driver: the socket support Hyperdrive connects
  // through comes from the Node compatibility layer.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // `id` is a placeholder, and unlike `kv_namespaces` this binding cannot omit
  // it: wrangler's own config schema marks it required and every documented
  // example carries one. No Hyperdrive configuration exists on the account
  // (`wrangler hyperdrive list` is empty) and creating one is the owner's call,
  // so the real id arrives with the infrastructure story that creates it per
  // environment and points it at `reme_app`.
  //
  // `wrangler dev` never reads the id. It connects to whatever
  // `CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE` holds, which is
  // how this runs against a local Postgres with no Cloudflare resource in
  // existence; `pnpm dev` fills it from `DATABASE_URL`. The sibling
  // `localConnectionString` field would do the same job and is not used,
  // because a connection string in a committed file is a password in a
  // committed file (R9), and the secret scan refuses it.
  //
  // A deploy fails on the placeholder id, which is the honest failure: there is
  // nothing to deploy to.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "0000000000000000000000000000000f"
    }
  ]
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reme-web",
  "compatibility_date": "2026-08-26",
  // `global_fetch_strictly_public` is what lets this Worker call `apps/api` at
  // all. Both live on one zone, `remeai.co.uk` (and before the custom domains,
  // the account's `workers.dev` subdomain), and a same-zone `fetch()` from one
  // Worker to another fails with Cloudflare error 1042 unless this flag is
  // set: without it the request is routed to the zone's origin, ignoring the
  // Worker mapped to the URL. Measured, not read: `/app` answered 500 on a
  // preview and 200 from the same code locally, where the call leaves the
  // machine and is not same-zone.
  //
  // It is the flag rather than a service binding because ADR-029 already chose
  // the public URL, and a binding decides whether `apps/api` has a public
  // hostname at all, which is a design question this does not settle. Every
  // other `fetch()` here already goes to the public internet (WorkOS), so
  // routing them all that way changes nothing else.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": "@tanstack/react-start/server-entry",
  "observability": { "enabled": true },
  // Explicit rather than inherited. The default has changed three times: before
  // wrangler 4.34 preview URLs were always on, 4.34 to 4.44 always off, and
  // 4.44 or later matches `workers_dev`. Preview environments per PR are
  // `wrangler versions upload --preview-alias`, so a wrangler upgrade that
  // moved this default again would take every preview URL down with it. The
  // vite plugin carries the field through to dist/server/wrangler.json, which
  // is the config a web deploy actually uploads; verified, not assumed. Load
  // bearing now that `workers_dev` is off: the default follows it.
  "preview_urls": true,
  // Staging's hostname (ADR-030), a custom domain like production's below.
  "workers_dev": false,
  // The zone route keeps staging off the production site router: see
  // apps/api/wrangler.jsonc.
  "routes": [
    { "pattern": "staging.remeai.co.uk", "custom_domain": true },
    { "pattern": "staging.remeai.co.uk/*", "zone_name": "remeai.co.uk" }
  ],
  // Not a secret: it is a public URL, it appears in the authorize redirect the
  // browser follows, and WorkOS will only honour it because it is registered on
  // the environment (`pnpm workos:config staging`). It is here rather than in
  // `wrangler secret` because the AuthKit middleware validates it on every
  // request, the public marketing page included, so a deploy without it answers
  // 500 on `/` rather than only on a sign-in.
  "vars": {
    "WORKOS_REDIRECT_URI": "https://staging.remeai.co.uk/api/auth/callback",
    // Where signup posts the org write (ADR-029). Not a secret and not a
    // service binding: a binding would also decide whether apps/api gets a
    // public hostname at all, which is a design question this does not settle.
    // The local value goes in apps/web/.dev.vars, which `pnpm bootstrap` writes.
    "REME_API_URL": "https://staging-api.remeai.co.uk"
  },
  // `reme-staging-web-cache`, created by `node infra/bootstrap.ts staging`. Dev
  // and preview still run against a local simulation of it; the id only decides
  // which namespace a deploy binds.
  "kv_namespaces": [
    { "binding": "CACHE", "id": "f5c3036a297e4612bba96014b7975d81" }
  ],
  // The auth forms' limit: five a minute per address for each of sign-in,
  // sign-up and asking for a reset email, and five per reset link. Needs no
  // resource to exist and no id from an account: `namespace_id` is a counter
  // name local to this Worker, so unlike Hyperdrive this one is real in dev,
  // preview and production from the day it lands.
  //
  // `period` takes 10 or 60 and nothing else. The reasoning behind the number,
  // and what this deliberately does not defend against, is in
  // src/lib/auth/throttle.ts; a test asserts this block against the constants
  // there, so the two cannot drift.
  "ratelimits": [
    {
      "name": "SIGN_IN_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // Production, on the one hostname every business shares (ADR-030). The
  // tenant is resolved from the session's `org_id` claim, never from the host,
  // so there is nothing per-tenant here and there never should be.
  //
  // `custom_domain: true` makes wrangler create and own the DNS record, which
  // is why no record is written by hand and none is committed anywhere.
  //
  // Bindings do not inherit, so vars, KV and the rate limit are declared again.
  // The KV id is `reme-prod-web-cache`; the rate limit is a counter name local
  // to the Worker, so production gets its own bucket by virtue of being its own
  // Worker rather than by carrying a different number.
  "env": {
    "production": {
      "name": "reme-web-production",
      "preview_urls": false,
      "workers_dev": false,
      "routes": [
        {
          "pattern": "preview.remeai.co.uk",
          "custom_domain": true
        },
        // Keeps this hostname off the site router: see apps/api/wrangler.jsonc.
        { "pattern": "preview.remeai.co.uk/*", "zone_name": "remeai.co.uk" }
      ],
      "vars": {
        "WORKOS_REDIRECT_URI": "https://preview.remeai.co.uk/api/auth/callback",
        "REME_API_URL": "https://api.remeai.co.uk"
      },
      "kv_namespaces": [
        { "binding": "CACHE", "id": "8e089aa00e324970a824ca2768201502" }
      ],
      "ratelimits": [
        {
          "name": "SIGN_IN_LIMIT",
          "namespace_id": "1001",
          "simple": { "limit": 5, "period": 60 }
        }
      ]
    }
  }
}

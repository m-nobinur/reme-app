// The site router (C6, ADR-030, ADR-032): one Worker for every tenant site
// and every preview, routed by hostname. Not placed near the database, because
// it never opens one: a published host is a KV pointer and an R2 read, a
// preview host is a signed claim and an R2 read. Staging owns
// `*-stg.remeai.co.uk/*`. Measured 2026-09-16 with two throwaway Workers: a
// pattern with the longer literal suffix wins the host, and a wildcard route
// beats a custom domain on the same hostname, with `fetch(request)` as the
// passthrough. No staging service hostname matches `*-stg.remeai.co.uk/*`, so
// staging passes nothing through and answers 404 instead.
//
// Production owns `*.remeai.co.uk/*`, which is the whole zone, so every service
// hostname does reach it and is passed through by name. That the zone-wide
// pattern loses `-stg` hosts to the longer literal suffix follows from the same
// 2026-09-16 measurement, but the exact pair has not itself been run against
// the production zone: doing so puts a Worker in front of the live api for the
// length of the test. ADR-030 carries that as an amendment (issue #90).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reme-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  // The Postgres driver behind the KV-miss fallback needs the Node layer.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Minified as the api is. Measured with `pnpm size`: 228.95 KiB gzip
  // (1276.94 raw) before, 165.77 (681.18) after. `keep_names` defaults to
  // true, so the `postgres` error classes keep the `name` they copy into
  // `error.name`. The source map is uploaded so stack traces in Workers Logs
  // map back to `src/`; it does not count toward the bundle size.
  "minify": true,
  "upload_source_maps": true,
  // Neither host can answer a request correctly: a claim's host never equals a
  // workers.dev name and a pointer lookup on one always misses, so a preview
  // URL for this Worker is a URL that only ever 404s. The per-PR preview
  // workflow does not upload it; `pnpm size` bundles it on every PR.
  "preview_urls": false,
  "workers_dev": false,
  "routes": [
    { "pattern": "*-stg.remeai.co.uk/*", "zone_name": "remeai.co.uk" }
  ],
  // Empty on staging: no service hostname ends in `-stg.remeai.co.uk`, so the
  // route pattern never sends one here and there is nothing to pass through.
  "vars": { "SITE_HOST_SUFFIX": "-stg.remeai.co.uk", "SERVICE_HOSTS": "" },
  // `reme-staging-routes`, created by `node infra/bootstrap.ts staging`. The
  // routing cache (§11.1.3): `host:{hostname}` to a `SitePointer`, written by
  // the publisher, read here. Postgres stays the truth.
  "kv_namespaces": [
    { "binding": "ROUTES", "id": "1f8dffa950774f3cb41e2b28dac89767" }
  ],
  // The same bucket the orchestrator writes: `sites/{site}/{rev}/...`.
  "r2_buckets": [{ "binding": "SITES", "bucket_name": "reme-sites" }],
  // The truth behind the cache (§11.1.3): read on a pointer miss only, and
  // the answer is written back to KV. The same staging config as the api.
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "51fda187d78445c6852dbc334d9ac7ed" }
  ],
  // How often one address may send a name to Postgres on a pointer miss. A
  // visitor reaches that path only when KV has lost a pointer, so the number
  // is generous for them and small for a run of made-up names. Counted per
  // Cloudflare location, which is what the binding offers. `1001` is the web
  // app's sign-in limiter; a namespace id is unique across the account.
  "ratelimits": [
    {
      "name": "MISSES",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  // Production's route is the whole zone, which runs before the custom domains
  // of the api, the orchestrator and the app, and its suffix matches every
  // hostname in the zone. Both are why `SERVICE_HOSTS` is not empty here: those
  // names are handed back to Cloudflare rather than read as tenant sites
  // (issue #90, ADR-030).
  "env": {
    "production": {
      "name": "reme-router-production",
      "routes": [
        { "pattern": "*.remeai.co.uk/*", "zone_name": "remeai.co.uk" }
      ],
      "vars": {
        "SITE_HOST_SUFFIX": ".remeai.co.uk",
        "SERVICE_HOSTS": "remeai.co.uk,www.remeai.co.uk,api.remeai.co.uk,preview.remeai.co.uk,orchestrator.remeai.co.uk,staging.remeai.co.uk,staging-api.remeai.co.uk,staging-orchestrator.remeai.co.uk"
      },
      "observability": { "enabled": true },
      "preview_urls": false,
      "workers_dev": false,
      // `reme-prod-routes`, created by `node infra/bootstrap.ts prod`.
      "kv_namespaces": [
        { "binding": "ROUTES", "id": "a9aa0dcef20f49539b24ee10a2f9e83b" }
      ],
      // The one bucket, as on staging: every key carries its own site id.
      "r2_buckets": [
        { "binding": "SITES", "bucket_name": "reme-sites-production" }
      ],
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "42db5d04bb0e4249b3e5a88e62549218" }
      ],
      "ratelimits": [
        {
          "name": "MISSES",
          "namespace_id": "1002",
          "simple": { "limit": 20, "period": 60 }
        }
      ]
    }
  }
}

---
import { site } from "../site-config"

interface Props {
  title: string
}

const { title } = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      body {
        margin: 0;
        font: 16px/1.5 system-ui, sans-serif;
        color: #1c1c1c;
        background: #fafafa;
      }
      header,
      main,
      footer {
        max-width: 48rem;
        margin: 0 auto;
        padding: 1rem;
      }
      nav a {
        margin-right: 1rem;
      }
    </style>
  </head>
  <body>
    <header>
      {site.name && <strong>{site.name}</strong>}
      <nav>
        <a href="/">Home</a>
        <a href="/contact/">Contact</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      {site.serviceArea && <p>{site.serviceArea}</p>}
    </footer>
  </body>
</html>

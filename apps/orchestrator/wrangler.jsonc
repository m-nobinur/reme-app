// The orchestrator (C3): the assignment state machine as a Workflow, the
// console routes, the builder sandbox, and from N3 the Developer agent's
// Durable Object. The shape is `apps/api`'s: Hyperdrive to the same database,
// placed beside it, the default environment is staging. Flue adds `main` and
// the per-agent Durable Object bindings at build time into
// `.flue-vite.wrangler.jsonc`; never author a `FLUE_*` binding here.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reme-orchestrator",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "placement": { "region": "aws:eu-central-1" },
  "preview_urls": true,
  "workers_dev": false,
  // The zone route keeps this hostname off the production site router's
  // `*/*`: see apps/api/wrangler.jsonc.
  "routes": [
    { "pattern": "staging-orchestrator.remeai.co.uk", "custom_domain": true },
    {
      "pattern": "staging-orchestrator.remeai.co.uk/*",
      "zone_name": "remeai.co.uk"
    }
  ],
  // One connection per assignment rather than one subrequest per command:
  // the SDK reads this from the Worker's bindings, never from the container.
  // `SITE_HOST_SUFFIX` is what the router serves on: `{slug}` and
  // `preview-v{n}-{slug}` under it (ADR-030).
  // `CONSOLE_APPROVALS` lets the staff console approve a publish, which
  // staging allows and production never does (ADR-032).
  "vars": {
    "SANDBOX_TRANSPORT": "rpc",
    "SITE_HOST_SUFFIX": "-stg.remeai.co.uk",
    "CONSOLE_APPROVALS": "allow",
    // The Cloudflare for SaaS zone custom hostnames live in (src/domains.ts).
    // Staging shares it with production; `CF_DOMAINS_TOKEN` is the secret.
    "CF_DOMAINS_ZONE_ID": "a786a7b1f7e583b37a42936788d877c3",
    // Buying a domain (src/registrar.ts): the account the registrar bills,
    // Cloudflare's sandbox registrar here and locally (no money, never
    // served), and the Worker a bought domain is served by.
    "CF_ACCOUNT_ID": "f161d624d34c45dd59579f9ee45c4396",
    "REGISTRAR_API": "registrar-sandbox",
    "ROUTER_SERVICE": "reme-router",
    // The router serves it at /{key}.txt; the same value per environment.
    "INDEXNOW_KEY": "e589181a6d7f0ffecc3cfe5285688213",
    // Where an owner email links (src/deliveries.ts): the web app, as apps/api's WEB_ORIGIN.
    "APP_ORIGIN": "https://staging.remeai.co.uk"
  },
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "51fda187d78445c6852dbc334d9ac7ed" }
  ],
  "workflows": [
    {
      "name": "reme-assignment",
      "binding": "ASSIGNMENTS",
      "class_name": "AssignmentWorkflow"
    },
    {
      "name": "reme-publish",
      "binding": "PUBLISHES",
      "class_name": "PublishWorkflow"
    },
    {
      "name": "reme-sweep",
      "binding": "SWEEPS",
      "class_name": "SweepWorkflow"
    },
    // One instance per custom domain claim (src/domain-workflow.ts).
    {
      "name": "reme-domain",
      "binding": "DOMAINS",
      "class_name": "DomainWorkflow"
    },
    // One instance per org and host in Google Search Console (src/search-workflow.ts).
    {
      "name": "reme-search",
      "binding": "SEARCHES",
      "class_name": "SearchWorkflow"
    },
    // One instance per connected org a day, started by the sweep (src/search-sync.ts).
    {
      "name": "reme-search-sync",
      "binding": "SEARCH_SYNC",
      "class_name": "SearchSyncWorkflow"
    }
  ],
  // The hourly retention sweep (ADR-032), created by the `scheduled` handler
  // in src/cloudflare.ts; on Mondays at 07 UTC it also sends the weekly
  // search message. Production restates it; its uptime check shares the firing.
  "triggers": { "crons": ["0 * * * *"] },
  // The routing cache the router reads (§11.1.3), written by publish.ts and
  // by nothing else in this Worker; a test holds that.
  "kv_namespaces": [
    { "binding": "ROUTES", "id": "1f8dffa950774f3cb41e2b28dac89767" }
  ],
  // The builder sandbox (ADR-031). The image is a registry reference pinned
  // by digest, so a deploy needs no Docker and a PR that touches no image
  // never builds one; .github/workflows/sandbox-image.yml builds and pushes
  // on infra/sandbox/** and weekly, and a PR moves this pin. `standard-2` is
  // the §6.3 builder class. `max_instances` is the pool the Workflow waits on
  // with a `pool.exhausted` event when it is full.
  "containers": [
    {
      "class_name": "RemeSandbox",
      "image": "registry.cloudflare.com/f161d624d34c45dd59579f9ee45c4396/reme-sandbox@sha256:7ee0e400c961d6720b2ff412150a5a796e5cbf65647b02cbe6a2515914ef4ee2",
      "instance_type": "standard-2",
      "max_instances": 5
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SANDBOX", "class_name": "RemeSandbox" }]
  },
  // `FlueDeveloperAgent` is the class flue generates for the Developer agent
  // (src/agents/developer.ts); the migration is ours to author, the binding
  // is flue's. Append-only, per the DO migration rules.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RemeSandbox"] },
    { "tag": "v2", "new_sqlite_classes": ["FlueDeveloperAgent"] }
  ],
  // Site artifacts and source snapshots, `sites/{site_id}/{revision_id}/...`
  // (ADR-031). The same bucket under the name the Sandbox SDK's backups read,
  // so a container checkpoint lands beside the revision it belongs to.
  "r2_buckets": [
    { "binding": "SITES", "bucket_name": "reme-sites" },
    { "binding": "BACKUP_BUCKET", "bucket_name": "reme-sites" }
  ],
  // The outbox (src/deliveries.ts). `OWNER_MAIL` is Cloudflare Email Sending
  // from hello@remeai.co.uk, after `wrangler email sending enable remeai.co.uk`;
  // the uptime alert keeps its own binding. A message that fails five retries
  // is settled as failed in the row, so the dead-letter queue only holds what
  // the consumer itself could not handle.
  "send_email": [{ "name": "OWNER_MAIL" }],
  "queues": {
    "producers": [{ "binding": "DELIVERIES", "queue": "reme-deliveries" }],
    "consumers": [
      {
        "queue": "reme-deliveries",
        "max_retries": 5,
        "dead_letter_queue": "reme-deliveries-dlq"
      }
    ]
  },
  "env": {
    "production": {
      "name": "reme-orchestrator-production",
      "preview_urls": false,
      "workers_dev": false,
      "routes": [
        { "pattern": "orchestrator.remeai.co.uk", "custom_domain": true },
        // Keeps this hostname off the site router: see apps/api/wrangler.jsonc.
        {
          "pattern": "orchestrator.remeai.co.uk/*",
          "zone_name": "remeai.co.uk"
        }
      ],
      "vars": {
        "SANDBOX_TRANSPORT": "rpc",
        "SITE_HOST_SUFFIX": ".remeai.co.uk",
        "CF_DOMAINS_ZONE_ID": "a786a7b1f7e583b37a42936788d877c3",
        // The live registrar: real, non-refundable registrations, so buying
        // stays off until STRIPE_SECRET_KEY is set here.
        "CF_ACCOUNT_ID": "f161d624d34c45dd59579f9ee45c4396",
        "REGISTRAR_API": "registrar",
        "ROUTER_SERVICE": "reme-router-production",
        "INDEXNOW_KEY": "50d33f2d3b42e6d093cb945653fea6ca",
        "APP_ORIGIN": "https://preview.remeai.co.uk",
        // What the hourly uptime check fetches (src/uptime.ts). Not the
        // orchestrator's own hostname: a Worker fetching itself through its
        // custom domain gets 522 (measured 2026-09-29), and the check running
        // at all is the orchestrator's proof of life.
        "HEALTH_URLS": "https://api.remeai.co.uk/health https://preview.remeai.co.uk/"
      },
      // The sweep and the uptime check, one firing an hour so the database
      // wakes once (UPTIME_CRON). Staging has no HEALTH_URLS, so it sweeps only.
      "triggers": { "crons": ["0 * * * *"] },
      // The uptime check's alert email (src/uptime.ts). No destination
      // restriction: `ALERT_TO`, a secret, picks a verified address.
      "send_email": [{ "name": "ALERTS" }, { "name": "OWNER_MAIL" }],
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "42db5d04bb0e4249b3e5a88e62549218" }
      ],
      "workflows": [
        {
          "name": "reme-assignment-production",
          "binding": "ASSIGNMENTS",
          "class_name": "AssignmentWorkflow"
        },
        {
          "name": "reme-publish-production",
          "binding": "PUBLISHES",
          "class_name": "PublishWorkflow"
        },
        {
          "name": "reme-sweep-production",
          "binding": "SWEEPS",
          "class_name": "SweepWorkflow"
        },
        {
          "name": "reme-domain-production",
          "binding": "DOMAINS",
          "class_name": "DomainWorkflow"
        },
        {
          "name": "reme-search-production",
          "binding": "SEARCHES",
          "class_name": "SearchWorkflow"
        },
        {
          "name": "reme-search-sync-production",
          "binding": "SEARCH_SYNC",
          "class_name": "SearchSyncWorkflow"
        }
      ],
      "kv_namespaces": [
        { "binding": "ROUTES", "id": "a9aa0dcef20f49539b24ee10a2f9e83b" }
      ],
      "containers": [
        {
          "class_name": "RemeSandbox",
          "image": "registry.cloudflare.com/f161d624d34c45dd59579f9ee45c4396/reme-sandbox@sha256:7ee0e400c961d6720b2ff412150a5a796e5cbf65647b02cbe6a2515914ef4ee2",
          "instance_type": "standard-2",
          "max_instances": 5
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "SANDBOX", "class_name": "RemeSandbox" }]
      },
      // Created with `wrangler r2 bucket create --jurisdiction eu`; the router
      // reads it. The EU jurisdiction keeps tenant files in the EU.
      "r2_buckets": [
        {
          "binding": "SITES",
          "bucket_name": "reme-sites-production-eu",
          "jurisdiction": "eu"
        },
        {
          "binding": "BACKUP_BUCKET",
          "bucket_name": "reme-sites-production-eu",
          "jurisdiction": "eu"
        }
      ],
      "queues": {
        "producers": [
          { "binding": "DELIVERIES", "queue": "reme-deliveries-production" }
        ],
        "consumers": [
          {
            "queue": "reme-deliveries-production",
            "max_retries": 5,
            "dead_letter_queue": "reme-deliveries-dlq-production"
          }
        ]
      }
    }
  }
}

{
  "name": "orchestrator",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "cf-typegen": "wrangler types --env-file /dev/null",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/floor.mjs orchestrator-unit -- vitest run --dir test",
    "size": "node ../../scripts/size.mjs orchestrator --config dist/reme_orchestrator/wrangler.json",
    "test:probe": "node ../../scripts/floor.mjs orchestrator-probe -- vitest run --dir probe"
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.12.9",
    "@workspace/contracts": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/facade": "workspace:*",
    "@workspace/gates": "workspace:*",
    "@workspace/starter-site": "workspace:*",
    "hono": "4.13.11",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.2",
    "@flue/runtime": "2.3.0",
    "@flue/vite": "2.3.0",
    "@types/node": "^22",
    "fast-check": "^4.10.2",
    "typescript": "^6",
    "ulid": "3.0.2",
    "vite": "8.3.1",
    "vitest": "^5.0.5",
    "wrangler": "4.144.0"
  }
}

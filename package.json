{
  "name": "reme",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "preflight": "node scripts/preflight.mjs",
    "dev:session": "node apps/api/scripts/dev-session.mjs",
    "seed": "node scripts/seed.mjs",
    "workos:config": "node scripts/workos.mjs",
    "eval": "node --experimental-transform-types evals/run.mjs",
    "record": "node --experimental-transform-types evals/record.mjs",
    "record:session": "node --experimental-transform-types evals/record-session.mjs",
    "builder": "node scripts/builder.mjs",
    "model": "node scripts/model.mjs",
    "db:generate": "pnpm --filter @workspace/db db:generate",
    "db:migrate": "pnpm --filter @workspace/db db:migrate",
    "probe:clear": "pnpm --filter @workspace/db probe:clear",
    "build": "turbo build",
    "dev": "turbo dev",
    "typecheck": "turbo typecheck",
    "test": "VITEST_MAX_WORKERS=3 turbo test --filter=!@workspace/ui --concurrency=2",
    "test:ci": "turbo test --filter=!@workspace/ui --concurrency=4",
    "e2e": "pnpm --filter e2e e2e",
    "e2e:golden": "pnpm --filter e2e golden",
    "test:tenancy": "pnpm --filter @workspace/db test:tenancy && pnpm --filter api test:tenancy",
    "test:seed": "pnpm --filter @workspace/db test:seed",
    "size": "turbo size --force",
    "check:secrets": "turbo check:secrets --force",
    "lint": "node scripts/lint/colour-rule.mjs && node scripts/lint/icon-library.mjs && biome check --error-on-warnings",
    "lint:ci": "node scripts/lint/colour-rule.mjs && node scripts/lint/icon-library.mjs && biome ci --error-on-warnings",
    "lint:fix": "biome check --write --unsafe",
    "lint:classes": "biome check --write --unsafe --only=nursery/useSortedClasses",
    "format": "biome format --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@workspace/config": "workspace:*",
    "@workspace/contracts": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/facade": "workspace:*",
    "@workspace/gates": "workspace:*",
    "postgres": "3.4.9",
    "turbo": "^2.11.9",
    "typescript": "^6",
    "zod": "4.6.7"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24"
  }
}

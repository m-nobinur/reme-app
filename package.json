{
  "name": "reme",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "preflight": "node scripts/preflight.mjs",
    "seed": "node scripts/seed.mjs",
    "workos:config": "node scripts/workos.mjs",
    "eval": "node evals/run.mjs",
    "record": "node evals/record.mjs",
    "db:generate": "pnpm --filter @workspace/db db:generate",
    "db:migrate": "pnpm --filter @workspace/db db:migrate",
    "build": "turbo build",
    "dev": "turbo dev",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:ci": "turbo test --filter=!@workspace/ui",
    "test:tenancy": "pnpm --filter @workspace/db test:tenancy",
    "test:seed": "pnpm --filter @workspace/db test:seed",
    "size": "turbo size --force",
    "check:secrets": "turbo check:secrets --force",
    "lint": "node scripts/lint/colour-rule.mjs && biome check --error-on-warnings",
    "lint:ci": "node scripts/lint/colour-rule.mjs && biome ci --error-on-warnings",
    "lint:fix": "biome check --write --unsafe",
    "lint:classes": "biome check --write --unsafe --only=nursery/useSortedClasses",
    "format": "biome format --write"
  },
  "devDependencies": {
    "@workspace/config": "workspace:*",
    "@workspace/db": "workspace:*",
    "@biomejs/biome": "2.5.10",
    "turbo": "^2.9.18",
    "typescript": "^6"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24"
  }
}

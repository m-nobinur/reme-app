{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  // The only linter and formatter in the tree. There is exactly one of these files
  // and it lives at the root: a nested biome.jsonc re-roots path matching and drops
  // these overrides. It is .jsonc and not .json because a // comment in a .json makes
  // Biome discard the whole config and pass with defaults, silently.
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": false,
    // Generated by the TanStack router plugin and rewritten on every dev run.
    "includes": ["**", "!**/*.gen.ts"]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "attributePosition": "auto",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "expand": "auto",
    "useEditorconfig": true,
    "includes": [
      "**",
      "!**/dist/",
      "!**/node_modules/",
      "!**/.turbo/",
      "!**/.output/",
      "!**/.nitro/",
      "!**/.tanstack/",
      "!**/.vinxi/",
      "!**/coverage/",
      "!**/pnpm-lock.yaml",
      "!**/.pnpm-store/"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noAdjacentSpacesInRegex": "error",
        "noExtraBooleanCast": "error",
        "noUselessCatch": "error",
        "noUselessEscapeInRegex": "error"
      },
      "correctness": {
        "noConstantCondition": "error",
        "noEmptyCharacterClassInRegex": "error",
        "noEmptyPattern": "error",
        "noNonoctalDecimalEscape": "error",
        "noPrecisionLoss": "error",
        "noSelfAssign": "error",
        "noSwitchDeclarations": "error",
        "noUnsafeFinally": "error",
        "noUnsafeOptionalChaining": "error",
        "noUnusedLabels": "error",
        "noUnusedPrivateClassMembers": "error",
        "useIsNan": "error",
        "useValidForDirection": "error",
        "useValidTypeof": "error",
        "useYield": "error"
      },
      "nursery": {
        "useImportsFirst": "error",
        // Tailwind class order. Nursery, defaults to info, and its fix is classified
        // unsafe, so it needs "error" here and `biome check --write --unsafe` to apply.
        // Known gaps against prettier-plugin-tailwindcss: it does not sort screen
        // variants (md:, max-lg:) and it only knows the default Tailwind config, so
        // plugin utilities sort by the built-in order.
        "useSortedClasses": {
          "level": "error",
          "options": { "functions": ["clsx", "cva", "cn"] }
        }
      },
      "style": {
        "noCommonJs": "error",
        "noInferrableTypes": "error",
        "noNamespace": "error",
        // Off in the scaffold's ESLint config, kept off here.
        "useConsistentArrayType": "off",
        "useAsConstAssertion": "error",
        "useConsistentMethodSignatures": "error",
        "useConst": "error",
        "useForOf": "warn"
      },
      "suspicious": {
        "noAsyncPromiseExecutor": "error",
        "noCatchAssign": "error",
        "noClassAssign": "error",
        "noCompareNegZero": "error",
        "noConstantBinaryExpressions": "error",
        "noControlCharactersInRegex": "error",
        "noDebugger": "error",
        "noDuplicateCase": "error",
        "noDuplicateElseIf": "error",
        "noDuplicateEnumValues": "error",
        "noEmptyBlockStatements": "error",
        "noExtraNonNullAssertion": "error",
        "noFallthroughSwitchClause": "error",
        "noGlobalAssign": "error",
        // Off in the scaffold's ESLint config, kept off here.
        "noImportCycles": "off",
        "noIrregularWhitespace": "error",
        "noMisleadingCharacterClass": "error",
        "noMisleadingInstantiator": "error",
        "noNonNullAssertedOptionalChain": "error",
        "noShadow": "warn",
        "noShadowRestrictedNames": "error",
        "noSparseArray": "error",
        "noUselessRegexBackrefs": "error",
        "noVar": "error",
        "noWith": "error",
        // Off in the scaffold's ESLint config, kept off here.
        "useAwait": "off"
      }
    },
    "includes": [
      "**",
      "!**/.nx/**",
      "!**/.svelte-kit/**",
      "!**/build/**",
      "!**/coverage/**",
      "!**/dist/**",
      "!**/snap/**",
      "!**/vite.config.*.timestamp-*.*"
    ]
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "es5",
      "semicolons": "asNeeded",
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "quoteStyle": "double",
      "attributePosition": "auto",
      "bracketSpacing": true
    }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "html": {
    "formatter": {
      "indentScriptAndStyle": false,
      "selfCloseVoidElements": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  }
}

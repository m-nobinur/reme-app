{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": false,
    // Generated: the TanStack router plugin rewrites the route tree on every
    // dev run, and `wrangler types` rewrites the Worker binding types.
    "includes": ["**", "!**/*.gen.ts", "!**/worker-configuration.d.ts"]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "attributePosition": "auto",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "expand": "auto",
    "useEditorconfig": true,
    "includes": [
      "**",
      "!**/dist/",
      "!**/node_modules/",
      "!**/.turbo/",
      "!**/.output/",
      "!**/.nitro/",
      "!**/.tanstack/",
      "!**/.vinxi/",
      "!**/coverage/",
      "!**/pnpm-lock.yaml",
      "!**/.pnpm-store/"
    ]
  },
  // Dependency direction, from 3-engineering.md: apps/* -> packages/*;
  // packages/* -> contracts | config | observability only; contracts imports
  // nothing. Biome matches the import string and not the resolved package, so
  // each block names the bare specifier and the relative path that means the
  // same thing. A narrower block replaces a wider one rather than merging with
  // it, so each repeats the whole pattern set.
  //
  // Adding a package needs no change here unless it joins the allowed set, in
  // which case add "!@workspace/<name>" and "!@workspace/<name>/**" to the
  // first group of every block.
  "overrides": [
    {
      // apps/* -> packages/* is permissive, so nothing is banned by name here.
      // The relative reach still is: it skips the package's exports the same way
      // it does between packages. An app needs a different pattern from the one
      // the packages blocks use, because an app nests deeply enough that
      // "../../..." is an ordinary in-app import; every reach out of an app,
      // at any depth, goes through a literal "packages/" segment instead.
      "includes": ["apps/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/packages/*/**"],
                    "message": "Import a package by name. A relative path into another package skips its exports and this check."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@workspace/*",
                      "@workspace/*/**",
                      "!@workspace/contracts",
                      "!@workspace/contracts/**",
                      "!@workspace/config",
                      "!@workspace/config/**",
                      "!@workspace/observability",
                      "!@workspace/observability/**"
                    ],
                    "message": "A package may import only @workspace/contracts, @workspace/config and @workspace/observability."
                  },
                  {
                    // Escapes are named, not counted. A relative reach out of a
                    // package always passes through a sibling's directory name,
                    // so the names are listed. Counting "../" instead does not
                    // work: depth is not fixed, and "../../lib/utils" from
                    // src/components/ never leaves its own package. Add a line
                    // here when a package is added, same as the negations above.
                    "group": [
                      "**/contracts/src/**",
                      "**/config/src/**",
                      "**/ui/src/**",
                      "**/db/src/**"
                    ],
                    "message": "Import a package by name. A relative path into another package skips its exports and this check."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // shadcn writes self-imports as "@workspace/ui/lib/utils" and rewrites them
      // on every `shadcn add`, so ui is allowed to name itself. A package that
      // does the same needs its own block here.
      "includes": ["packages/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@workspace/*",
                      "@workspace/*/**",
                      "!@workspace/contracts",
                      "!@workspace/contracts/**",
                      "!@workspace/config",
                      "!@workspace/config/**",
                      "!@workspace/observability",
                      "!@workspace/observability/**",
                      "!@workspace/ui",
                      "!@workspace/ui/**"
                    ],
                    "message": "A package may import only @workspace/contracts, @workspace/config, @workspace/observability and itself."
                  },
                  {
                    "group": [
                      "**/contracts/src/**",
                      "**/config/src/**",
                      "**/ui/src/**",
                      "**/db/src/**"
                    ],
                    "message": "Import a package by name. A relative path into another package skips its exports and this check."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // contracts is the base of the graph and imports no workspace package.
      "includes": ["packages/contracts/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@workspace/*", "@workspace/*/**"],
                    "message": "contracts imports nothing from the workspace."
                  },
                  {
                    "group": [
                      "**/contracts/src/**",
                      "**/config/src/**",
                      "**/ui/src/**",
                      "**/db/src/**"
                    ],
                    "message": "Import a package by name. A relative path into another package skips its exports and this check."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "linter": {
    "enabled": true,
    "domains": { "types": "all" },
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noAdjacentSpacesInRegex": "error",
        "noExtraBooleanCast": "error",
        "noUselessCatch": "error",
        "noUselessEscapeInRegex": "error"
      },
      "correctness": {
        "noConstantCondition": "error",
        "noEmptyCharacterClassInRegex": "error",
        "noEmptyPattern": "error",
        "noNonoctalDecimalEscape": "error",
        "noPrecisionLoss": "error",
        "noSelfAssign": "error",
        "noSwitchDeclarations": "error",
        "noUnsafeFinally": "error",
        "noUnsafeOptionalChaining": "error",
        "noUnusedLabels": "error",
        "noUnusedPrivateClassMembers": "error",
        "useIsNan": "error",
        "useValidForDirection": "error",
        "useValidTypeof": "error",
        "useYield": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "useImportsFirst": "error",
        "useSortedClasses": {
          "level": "error",
          "options": { "functions": ["clsx", "cva", "cn"] }
        }
      },
      "style": {
        "noCommonJs": "error",
        "noInferrableTypes": "error",
        "noNamespace": "error",
        "useConsistentArrayType": "off",
        "useAsConstAssertion": "error",
        "useConsistentMethodSignatures": "error",
        "useConst": "error",
        "useForOf": "warn"
      },
      "suspicious": {
        "noAsyncPromiseExecutor": "error",
        "noCatchAssign": "error",
        "noClassAssign": "error",
        "noCompareNegZero": "error",
        "noConstantBinaryExpressions": "error",
        "noControlCharactersInRegex": "error",
        "noDebugger": "error",
        "noDuplicateCase": "error",
        "noDuplicateElseIf": "error",
        "noDuplicateEnumValues": "error",
        "noEmptyBlockStatements": "error",
        "noExtraNonNullAssertion": "error",
        "noFallthroughSwitchClause": "error",
        "noGlobalAssign": "error",
        "noImportCycles": "off",
        "noUnnecessaryConditions": "error",
        "noIrregularWhitespace": "error",
        "noMisleadingCharacterClass": "error",
        "noMisleadingInstantiator": "error",
        "noNonNullAssertedOptionalChain": "error",
        "noShadow": "warn",
        "noShadowRestrictedNames": "error",
        "noSparseArray": "error",
        "noUselessRegexBackrefs": "error",
        "noVar": "error",
        "noWith": "error",
        "useAwait": "off"
      }
    },
    "includes": [
      "**",
      "!**/.nx/**",
      "!**/.svelte-kit/**",
      "!**/build/**",
      "!**/coverage/**",
      "!**/dist/**",
      "!**/snap/**",
      "!**/vite.config.*.timestamp-*.*"
    ]
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "es5",
      "semicolons": "asNeeded",
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "quoteStyle": "double",
      "attributePosition": "auto",
      "bracketSpacing": true
    }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "html": {
    "formatter": {
      "indentScriptAndStyle": false,
      "selfCloseVoidElements": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  }
}

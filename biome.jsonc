{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  // Colour tokens, not colour values. Biome has no rule for it, so the check is a
  // GritQL plugin; loading it here is what puts it in `pnpm lint`, `biome ci` and
  // the pre-commit hook at once.
  "plugins": ["./scripts/lint/no-hardcoded-colours.grit"],
  "files": {
    "ignoreUnknown": false,
    // Generated: the TanStack router plugin rewrites the route tree on every
    // dev run, `wrangler types` rewrites the Worker binding types, and
    // drizzle-kit rewrites the migration snapshots. Formatting the last of
    // those would put the repo permanently at odds with the next `db:generate`.
    "includes": [
      "**",
      "!**/*.gen.ts",
      "!**/worker-configuration.d.ts",
      "!packages/db/drizzle"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "attributePosition": "auto",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "expand": "auto",
    "useEditorconfig": true,
    "includes": [
      "**",
      "!**/dist/",
      "!**/node_modules/",
      "!**/.turbo/",
      "!**/.output/",
      "!**/.nitro/",
      "!**/.tanstack/",
      "!**/.vinxi/",
      "!**/coverage/",
      "!**/pnpm-lock.yaml",
      "!**/.pnpm-store/"
    ]
  },
  // Dependency direction, from 3-engineering.md: apps/* -> packages/*;
  // packages/* -> contracts | config | observability only; contracts imports
  // nothing. Biome matches the import string and not the resolved package, so
  // each block names the bare specifier and the relative path that means the
  // same thing. A narrower block replaces a wider one rather than merging with
  // it, so each repeats the whole pattern set.
  //
  // Adding a package needs no change here unless it joins the allowed set, in
  // which case add "!@workspace/<name>" and "!@workspace/<name>/**" to the
  // first group of every block.
  "overrides": [
    {
      // Biome reads only the frontmatter of an .astro file, so an import the
      // template uses looks unused to it. Astro itself reports a real one.
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      // apps/* -> packages/* is permissive, so nothing is banned by name here.
      // The relative reach still is: it skips the package's exports the same way
      // it does between packages. An app needs a different pattern from the one
      // the packages blocks use, because an app nests deeply enough that
      // "../../..." is an ordinary in-app import; every reach out of an app,
      // at any depth, goes through a literal "packages/" segment instead.
      "includes": ["apps/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/packages/*/**"],
                    "message": "Import a package by name. A relative path into another package skips its exports and this check."
                  },
                  {
                    "group": ["@flue/*", "@earendil-works/*"],
                    "message": "packages/facade is the only importer of flue and Pi (R2). Agent modules take hooks from the facade."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // The Chief of Staff's code. The model's history is derived from the
      // event log (ADR-034), so nothing here may import `conversationMessages`,
      // the mutable rows the screen shows. This is a tripwire; the hash check
      // before each model call is the boundary. Narrower than the apps block
      // and so replacing it, which is why its patterns are repeated.
      "includes": ["apps/api/src/cos/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@workspace/db": {
                    "importNames": ["conversationMessages"],
                    "message": "The CoS reads its history from the event log only (ADR-034). conversation_messages is what the screen shows and never reaches the model."
                  },
                  "@workspace/db/schema": {
                    "importNames": ["conversationMessages"],
                    "message": "The CoS reads its history from the event log only (ADR-034). conversation_messages is what the screen shows and never reaches the model."
                  }
                },
                "patterns": [
                  {
                    // Each imports conversationMessages or a module that does,
                    // so reaching them from here goes round the ban above, and
                    // chat.ts will import this directory. The change path lives
                    // in ../changes.ts and shared helpers in ../http.ts.
                    // `**/../chat` matches a specifier whose last step climbs
                    // to chat, at any depth: `../chat.ts` from cos/ and
                    // `../../chat.ts` from cos/agent/, never `./chat.ts`
                    // (checked against Biome 2.5.10).
                    "group": [
                      "**/../chat",
                      "**/../chat.ts",
                      "**/../conversations",
                      "**/../conversations.ts",
                      "**/../owner",
                      "**/../owner.ts",
                      "**/../org",
                      "**/../org.ts"
                    ],
                    "message": "cos/ must not import chat.ts, conversations.ts, owner.ts or org.ts: each reaches conversation_messages (ADR-034), and chat.ts will import cos/. Take the change path from ../changes.ts and shared helpers from ../http.ts."
                  },
                  {
                    "group": ["**/packages/*/**"],
                    "message": "Import a package by name. A relative path into another package skips its exports and this check."
                  },
                  {
                    "group": ["@flue/*", "@earendil-works/*"],
                    "message": "packages/facade is the only importer of flue and Pi (R2). Agent modules take hooks from the facade."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // The one file allowed to import `@flue/vite`: the orchestrator's build
      // has to load the plugin that scans agents and generates their Durable
      // Objects. Narrower than the apps block, so the relative-reach pattern
      // is repeated rather than inherited.
      "includes": ["apps/orchestrator/vite.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/packages/*/**"],
                    "message": "Import a package by name. A relative path into another package skips its exports and this check."
                  },
                  {
                    "group": [
                      "@flue/runtime",
                      "@flue/sdk",
                      "@earendil-works/*"
                    ],
                    "message": "Only @flue/vite is allowed here, for the build. Runtime imports belong in packages/facade (R2)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // Narrower than the apps block above and so replacing it, which is why the
      // relative-reach pattern is repeated here rather than inherited.
      //
      // apps/web must not reach the database. ADR-026 moved the owner session
      // into this Worker, which makes it the one app where somebody would
      // reasonably try: the session is here, so the tenant row feels like it
      // should be too. It is not. §9.2 layer 1 puts the server-created tenant
      // context on the only path to a database handle, and that path is
      // apps/api. This Worker holds no binding, and this rule is what says so
      // before a review has to.
      //
      // The exception for "@workspace/db/fixtures" is gone with the mock that
      // needed it. The owner screens read `apps/api` now, so no module in this
      // Worker imports anything from the database package, fixture data
      // included, and the rule is the whole package again.
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/packages/*/**"],
                    "message": "Import a package by name. A relative path into another package skips its exports and this check."
                  },
                  {
                    "group": [
                      "@workspace/db",
                      "@workspace/db/**",
                      "**/db/src/**"
                    ],
                    "message": "apps/web has no database binding and must not import @workspace/db. Reads and writes go through apps/api, which is the only holder of a tenant context (architecture §9.2 layer 1)."
                  },
                  {
                    "group": [
                      "@base-ui/react",
                      "@base-ui/react/**",
                      "@radix-ui/*",
                      "@radix-ui/**"
                    ],
                    "message": "A page reaches a primitive through @workspace/ui, never the library underneath. Exit gate 5 says every page is built exclusively from packages/ui, and until this rule existed that was true by habit. A primitive imported here arrives with no catalog entry, no axe scan and no snapshot, which is the whole cost of the catalog being the only door."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // Narrower than the apps block above and so replacing it, which is why the
      // relative-reach pattern is repeated here rather than inherited.
      //
      // apps/router serves tenant sites at the edge from a KV pointer and an R2
      // read, or from a signed claim and an R2 read (ADR-032). The database is
      // the truth behind the pointer and is read on a miss only, through the
      // slug the hostname names and never an id from the request (§11.1.8);
      // the facade and Pi stay out, as everywhere outside packages/facade.
      "includes": ["apps/router/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/packages/*/**"],
                    "message": "Import a package by name. A relative path into another package skips its exports and this check."
                  },
                  {
                    "group": ["@flue/*", "@earendil-works/*"],
                    "message": "packages/facade is the only importer of flue and Pi (R2). Take hooks from @workspace/facade."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@workspace/*",
                      "@workspace/*/**",
                      "!@workspace/contracts",
                      "!@workspace/contracts/**",
                      "!@workspace/config",
                      "!@workspace/config/**",
                      "!@workspace/observability",
                      "!@workspace/observability/**"
                    ],
                    "message": "A package may import only @workspace/contracts, @workspace/config and @workspace/observability."
                  },
                  {
                    // Escapes are named, not counted. A relative reach out of a
                    // package always passes through a sibling's directory name,
                    // so the names are listed. Counting "../" instead does not
                    // work: depth is not fixed, and "../../lib/utils" from
                    // src/components/ never leaves its own package. Add a line
                    // here when a package is added, same as the negations above.
                    "group": [
                      "**/contracts/src/**",
                      "**/config/src/**",
                      "**/ui/src/**",
                      "**/db/src/**",
                      "**/facade/src/**",
                      "**/starter-site/src/**"
                    ],
                    "message": "Import a package by name. A relative path into another package skips its exports and this check."
                  },
                  {
                    "group": ["@flue/*", "@earendil-works/*"],
                    "message": "packages/facade is the only importer of flue and Pi (R2). Take hooks from @workspace/facade."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // The tenant site's source. The Developer builds it in a sandbox holding
      // only the Astro toolchain, so `src/` imports nothing from the workspace,
      // contracts included. Its tests and scripts may; they never reach the
      // sandbox. Narrower than the packages block and so replacing it.
      "includes": ["packages/starter-site/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@workspace/*", "@workspace/*/**"],
                    "message": "packages/starter-site/src builds in a sandbox with no workspace packages. Copy what it needs (tokens.css is a byte-identical copy, checked by the starter's tests)."
                  },
                  {
                    "group": [
                      "**/contracts/src/**",
                      "**/config/src/**",
                      "**/ui/src/**",
                      "**/db/src/**",
                      "**/facade/src/**"
                    ],
                    "message": "packages/starter-site/src builds in a sandbox with no workspace packages, so it cannot reach into one by path either."
                  },
                  {
                    "group": ["@flue/*", "@earendil-works/*"],
                    "message": "packages/facade is the only importer of flue and Pi (R2). Take hooks from @workspace/facade."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // The one package that may import flue and Pi (R2, ADR-031). Narrower
      // than the packages block and so replacing it, which is why the
      // workspace and relative-reach patterns are repeated without the ban.
      "includes": ["packages/facade/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@workspace/*",
                      "@workspace/*/**",
                      "!@workspace/contracts",
                      "!@workspace/contracts/**",
                      "!@workspace/config",
                      "!@workspace/config/**",
                      "!@workspace/observability",
                      "!@workspace/observability/**"
                    ],
                    "message": "A package may import only @workspace/contracts, @workspace/config and @workspace/observability."
                  },
                  {
                    "group": [
                      "**/contracts/src/**",
                      "**/config/src/**",
                      "**/ui/src/**",
                      "**/db/src/**"
                    ],
                    "message": "Import a package by name. A relative path into another package skips its exports and this check."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // shadcn writes self-imports as "@workspace/ui/lib/utils" and rewrites them
      // on every `shadcn add`, so ui is allowed to name itself. A package that
      // does the same needs its own block here.
      "includes": ["packages/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@workspace/*",
                      "@workspace/*/**",
                      "!@workspace/contracts",
                      "!@workspace/contracts/**",
                      "!@workspace/config",
                      "!@workspace/config/**",
                      "!@workspace/observability",
                      "!@workspace/observability/**",
                      "!@workspace/ui",
                      "!@workspace/ui/**"
                    ],
                    "message": "A package may import only @workspace/contracts, @workspace/config, @workspace/observability and itself."
                  },
                  {
                    "group": [
                      "**/contracts/src/**",
                      "**/config/src/**",
                      "**/ui/src/**",
                      "**/db/src/**",
                      "**/facade/src/**"
                    ],
                    "message": "Import a package by name. A relative path into another package skips its exports and this check."
                  },
                  {
                    "group": ["@flue/*", "@earendil-works/*"],
                    "message": "packages/facade is the only importer of flue and Pi (R2). Take hooks from @workspace/facade."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // contracts is the base of the graph and imports no workspace package.
      "includes": ["packages/contracts/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@workspace/*", "@workspace/*/**"],
                    "message": "contracts imports nothing from the workspace."
                  },
                  {
                    "group": [
                      "**/contracts/src/**",
                      "**/config/src/**",
                      "**/ui/src/**",
                      "**/db/src/**",
                      "**/facade/src/**"
                    ],
                    "message": "Import a package by name. A relative path into another package skips its exports and this check."
                  },
                  {
                    "group": ["@flue/*", "@earendil-works/*"],
                    "message": "packages/facade is the only importer of flue and Pi (R2). Take hooks from @workspace/facade."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "linter": {
    "enabled": true,
    "domains": { "types": "all" },
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noAdjacentSpacesInRegex": "error",
        "noExtraBooleanCast": "error",
        "noUselessCatch": "error",
        "noUselessEscapeInRegex": "error"
      },
      "correctness": {
        "noConstantCondition": "error",
        "noEmptyCharacterClassInRegex": "error",
        "noEmptyPattern": "error",
        "noNonoctalDecimalEscape": "error",
        "noPrecisionLoss": "error",
        "noSelfAssign": "error",
        "noSwitchDeclarations": "error",
        "noUnsafeFinally": "error",
        "noUnsafeOptionalChaining": "error",
        "noUnusedLabels": "error",
        "noUnusedPrivateClassMembers": "error",
        "useIsNan": "error",
        "useValidForDirection": "error",
        "useValidTypeof": "error",
        "useYield": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "useImportsFirst": "error",
        "useSortedClasses": {
          "level": "error",
          "options": { "functions": ["clsx", "cva", "cn"] }
        }
      },
      "style": {
        "noCommonJs": "error",
        "noInferrableTypes": "error",
        "noNamespace": "error",
        "useConsistentArrayType": "off",
        "useAsConstAssertion": "error",
        "useConsistentMethodSignatures": "error",
        "useConst": "error",
        "useForOf": "warn"
      },
      "suspicious": {
        "noAsyncPromiseExecutor": "error",
        "noCatchAssign": "error",
        "noClassAssign": "error",
        "noCompareNegZero": "error",
        "noConstantBinaryExpressions": "error",
        "noControlCharactersInRegex": "error",
        "noDebugger": "error",
        "noDuplicateCase": "error",
        "noDuplicateElseIf": "error",
        "noDuplicateEnumValues": "error",
        "noEmptyBlockStatements": "error",
        "noExtraNonNullAssertion": "error",
        "noFallthroughSwitchClause": "error",
        "noGlobalAssign": "error",
        "noImportCycles": "off",
        "noUnnecessaryConditions": "error",
        "noIrregularWhitespace": "error",
        "noMisleadingCharacterClass": "error",
        "noMisleadingInstantiator": "error",
        "noNonNullAssertedOptionalChain": "error",
        "noShadow": "warn",
        "noShadowRestrictedNames": "error",
        "noSparseArray": "error",
        "noUselessRegexBackrefs": "error",
        "noVar": "error",
        "noWith": "error",
        "useAwait": "off"
      }
    },
    "includes": [
      "**",
      "!**/.nx/**",
      "!**/.svelte-kit/**",
      "!**/build/**",
      "!**/coverage/**",
      "!**/dist/**",
      "!**/snap/**",
      "!**/vite.config.*.timestamp-*.*"
    ]
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "es5",
      "semicolons": "asNeeded",
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "quoteStyle": "double",
      "attributePosition": "auto",
      "bracketSpacing": true
    }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "html": {
    "formatter": {
      "indentScriptAndStyle": false,
      "selfCloseVoidElements": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  }
}

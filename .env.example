# Names and shapes only. Never a real value: this file is committed.
# `pnpm bootstrap` copies it to .env.local, which is gitignored. Put values there.
# The schema that validates these lives in packages/config/src/index.ts.

# Postgres. The default is a Neon branch. Two endpoints, and which one matters:
# the app runs on the pooled connection string, while `pnpm db:migrate` requires
# the direct one and exits 1 on a `-pooler` host, because its advisory lock is
# session-scoped and PgBouncer in transaction mode silently drops it.
# Direct: `neonctl connection-string <branch>`. Pooled: add --pooled.
# For the offline path, set NEON_OFFLINE=1 and use the docker-compose Postgres,
# which is postgresql://<user>:<password>@localhost:5432/<db> per docker-compose.yml.
DATABASE_URL=

# The pooled endpoint of the same branch, `neonctl connection-string <branch>
# --pooled`. Optional, and read by one thing: `pnpm test:tenancy` measures what
# a transaction pooler does to a session-scoped setting, which is the trap the
# RLS context avoids. Leave it blank and that measurement skips.
DATABASE_URL_POOLED=

# 1 runs against the docker-compose Postgres instead of Neon. 0 is the default.
NEON_OFFLINE=0

# WorkOS, for the owner sign-in flow. `scripts/workos.mjs` reads the first two
# from here; the Worker does not. Everything apps/web reads at runtime comes
# from its own bindings, so the same four names also go in apps/web/.dev.vars
# for local dev and into `wrangler secret put` for a deployed Worker.
# Values for the staging environment come from the WorkOS dashboard.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# Where the provider sends the browser back. Must be one of the redirect URIs
# configured on the environment: `pnpm workos:config staging` sets them.
WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Encrypts the owner session cookie and the short-lived sign-in flow cookie.
# At least 32 characters, and it carries the entropy on its own because key
# derivation runs a single PBKDF2 iteration (ADR-024). Generate one with
# `openssl rand -base64 32`. Rotating it signs everyone out.
WORKOS_COOKIE_PASSWORD=

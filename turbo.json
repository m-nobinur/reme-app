{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["NEON_OFFLINE"],
  // The eval runner's Langfuse switch. Pass-through rather than `globalEnv`
  // because `pnpm eval` is not a turbo task, so hashing it would invalidate
  // every cached task on a variable none of them read. Declared here because
  // `noUndeclaredEnvVars` reads this file and lint fails on warnings.
  "globalPassThroughEnv": [
    "GITHUB_STEP_SUMMARY",
    "LANGFUSE_SECRET_KEY",
    "ORCHESTRATOR_TOKEN",
    "ORCHESTRATOR_URL"
  ],
  // The floor gate is part of every blocking suite's verdict, and it lives
  // outside the packages that run it. Without these two in the hash, raising a
  // floor leaves `test` cached: turbo replays the old pass and prints the old
  // floor. CI restores that cache across runs, so the gate would ratchet on
  // paper only.
  "globalDependencies": ["scripts/floor.mjs", "scripts/floors.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".output/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      // Declared so turbo passes it through under strict `envMode`. Without
      // this, `api#test` never saw a DATABASE_URL at all and its 8 live cases
      // skipped under `pnpm test` even on a developer machine that had a
      // database. It is hashed as well, so the 15-case run and the 23-case run
      // cache separately.
      //
      // Consequence: a developer with DATABASE_URL exported at an unmigrated
      // or unseeded database now fails `pnpm test` where it used to skip
      // clean. Intended. A suite failing against a broken database is
      // information. The hash holds the URL, not the database's state, so
      // `.githooks/pre-push` replays a pass cached against the same URL.
      "env": ["DATABASE_URL"]
    },
    // The starter site test builds into dist and then reads it. A package that
    // depends on the starter (the orchestrator bundles its source) makes turbo
    // run starter-site#build at the same time, and two astro builds in one dist
    // fail with ENOTEMPTY. Waiting for the build serialises them.
    //
    // This entry and the two below replace `test` rather than extend it, so
    // each repeats its fields. The `$TURBO_ROOT$` inputs are files a suite
    // reads from outside its package, which turbo cannot see: without them an
    // edit to one leaves the hash unchanged and a cached pass is replayed.
    // package.test.ts compares the tokens with packages/ui's and the
    // dependencies with the sandbox image's.
    "@workspace/starter-site#test": {
      "dependsOn": ["^build", "build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/packages/ui/src/styles/tokens.css",
        "$TURBO_ROOT$/infra/sandbox/astro/package.json"
      ],
      "env": ["DATABASE_URL"]
    },
    // seed.test.ts reads the sandbox image's package.json and
    // sandbox-config.test.ts its Dockerfile.
    "orchestrator#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/infra/sandbox/**"],
      "env": ["DATABASE_URL"]
    },
    // cos-import-ban.test.ts lints probe files with the repo's Biome config
    // and the plugin it loads.
    "api#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/biome.jsonc",
        "$TURBO_ROOT$/scripts/lint/no-hardcoded-colours.grit"
      ],
      "env": ["DATABASE_URL"]
    },
    // Not cached, unlike every other test task. This one compares screenshots
    // against per-platform baselines, so its result depends on the machine it
    // ran on, and nothing in the hash says which machine that was: a macOS run
    // and a Linux run of the same commit hash identically and would hand each
    // other a result the other could not have produced.
    "@workspace/ui#test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    // `cache: false` keeps the gate from replaying its own verdict, but the
    // build underneath it still restores from cache, and a restore writes the
    // cached `dist/**` over whatever was there without pruning. Build at one
    // commit, check out another, and `dist` holds both chunk sets; wrangler
    // uploads every file matching its module rules, so the gate counts the
    // stale ones. Measured: one planted 44-byte chunk moved the figure, and a
    // real dist left over from another commit read 911.90 KiB against a true
    // 839.59. So `pnpm size` passes `--force`, which reaches the build too and
    // lets vite empty the directory.
    "size": {
      "dependsOn": ["build"],
      "cache": false
    },
    // Reads the built client assets, so it needs the build. Not cached: the
    // answer depends on what is in dist/client on this machine, and a cached
    // pass would report clean against a bundle nobody scanned.
    "check:secrets": {
      "dependsOn": ["build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
